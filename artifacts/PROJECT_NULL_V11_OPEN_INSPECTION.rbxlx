name="Value">V11 extends the existing laboratories into an ocean vessel. Scene dimensions and waterline are implementation choices, not a canon depth. Existing protocols, incident chronology and save keys are retained.</string></Properties></Item><Item class="Model" referent="RBX00000000000000000000000070000E68"><Properties><string name="Name">Ocean_Vessel_V11</string></Properties><Item class="StringValue" referent="RBX00000000000000000000000070000E69"><Properties><string name="Name">DesignBasis</string><string name="Value">Marine research vessel around the existing B2 laboratory slab. Deck/waterline coordinates are scene construction values, not a canonical ocean depth. No simulated propulsion or arbitrary external assets.</string></Properties></Item><Item class="Model" referent="RBX00000000000000000000000070000E6A"><Properties><string name="Name">Hull_Plated_DoubleSkin</string></Properties><Item class="Part" referent="RBX00000000000000000000000070000E6B"><Properties><string name="Name">KeelPlate</string><Vector3 name="size"><X>20.04</X><Y>1.2</Y><Z>228</Z></Vector3><CoordinateFrame name="CFrame"><X>-130</X><Y>-85.4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4280430646</Color3uint8><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool></Properties></Item><Item class="Part" referent="RBX00000000000000000000000070000E6C"><Properties><string name="Name">InnerBottomPlate</string><Vector3 name="size"><X>20.04</X><Y>0.65</Y><Z>222</Z></Vector3><CoordinateFrame name="CFrame"><X>-130</X><Y>-81.8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0</R20><R21>