   status("НАСТРОЙКА ИЗМЕНЕНА\nКАЖДЫЙ КАНАЛ ВЛИЯЕТ НА НЕСКОЛЬКО ДАТЧИКОВ\nПРОВЕДИТЕ ПОВТОРНЫЕ ИЗМЕРЕНИЯ")
   refresh()
  end)
 end
 bind(course["Probe_"..i],function(p)
  if p~=owner or busy or not powered() then return end
  local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local point=course["Pad_"..i].Position
  if (Vector2.new(root.Position.X,root.Position.Z)-Vector2.new(point.X,point.Z)).Magnitude&gt;4 then status("ВСТАНЬТЕ В ОБЛАСТЬ ДАТЧИКА "..i);return end
  busy=true;local token=generation;local start=root.Position;local sum=0
  status("ИЗМЕРЕНИЕ "..i.." / 2 СЕКУНДЫ\nСОХРАНЯЙТЕ НЕПОДВИЖНОСТЬ")
  for k=1,20 do
   task.wait(.1)
   if token~=generation then return end
   if not root.Parent or (root.Position-start).Magnitude&gt;1.2 or not powered() then
    busy=false;status("ИЗМЕРЕНИЕ ОТБРОШЕНО\nДВИЖЕНИЕ ИЛИ ПОТЕРЯ ПИТАНИЯ");return
   end
   sum=sum+residual(i)+rng:NextNumber(-.02,.02)
  end
  samples[i]={value=sum/20,time=os.clock(),rev=revision};busy=false
  status("ИЗМЕРЕНИЕ ЗАПИСАНО\nСРАВНИТЕ ОТКЛИК ДО И ПОСЛЕ НАСТРОЙКИ")
  refresh()
 end)
end
bind(course.ValidateButton,function(p)
 if p~=owner or busy or not powered() then return end
 for i=1,3 do
  local s=samples[i]
  if not s or s.rev~=revision or os.clock()-s.time&gt;90 then status("НЕДОСТАТОЧНО ДАННЫХ\nНУЖНЫ 3 СВЕЖИХ ИЗМЕРЕНИЯ ОДНОЙ НАСТРОЙКИ");return end
  if math.abs(s.value)&gt;.25 then status("ПОЛЕ НЕ СКОМПЕНСИРОВАНО\nДОПУСК КАЖДОГО ДАТЧИКА: ±0.25\nПРОДОЛЖИТЕ НАСТРОЙКУ");return end
 end
 busy=true;local token=generation
 for k=1,40 do
  task.wait(.2)
  if token~=generation then return end
  if not powered() then reset("АВАРИЙНОЕ ЗАВЕРШЕНИЕ\nПРОПАЛО ПИТАНИЕ ИЛИ ОБДУВ");return end
