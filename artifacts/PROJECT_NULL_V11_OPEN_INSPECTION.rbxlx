me">RootHeight</string><double name="Value">3.35</double></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000070001DA6"><Properties><string name="Name">Route</string></Properties><Item class="Vector3Value" referent="RBX00000000000000000000000070001DA7"><Properties><string name="Name">Point_01</string><Vector3 name="Value"><X>72</X><Y>-28</Y><Z>28</Z></Vector3></Properties></Item></Item></Item></Item></Item></Item></Item><Item class="SpawnLocation" referent="RBX000000000000000000000000000003E2"><Properties><string name="Name">Arrival</string><Vector3 name="size"><X>6</X><Y>0.3</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>-63.85</Y><Z>-86</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0</R10><R11>1.0</R11><R12>-0.0</R12><R20>-0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><float name="Transparency">1</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4281981676</Color3uint8><bool name="CastShadow">false</bool><bool name="Neutral">true</bool><float name="Duration">0</float></Properties></Item><Item class="Camera" referent="RBX000000000000000000000000000003E7"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>0</X><Y>-56</Y><Z>-88</Z><R00>-1.0</R00><R01>0.0</R01><R02>1.2246467991473532e-16</R02><R10>0</R10><R11>1.0</R11><R12>-0.0</R12><R20>-1.2246467991473532e-16</R20><R21>-0.0</R21><R22>-1.0</R22></CoordinateFrame><token name="CameraType">0</token></Properties></Item></Item><Item class="Lighting" referent="RBX000000000000000000000000000003E6"><Properties><string name="Name">Lighting</string><float name="ClockTime">0</float><bool name="GlobalShadows">true</bool><float name="ExposureCompensation">-0.35</float><float name="Brightness">0.3</float><Color3 name="Ambient"><R>0.18</R><G>0.21</G><B>0.24</B></Color3><Color3 name="OutdoorAmbient"><R>0.12</R><G>0.14</G><B>0.17</B></Color3></Properties></Item><Item class="StarterPlayer" referent="RBX000000000000000000000000000003E8"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">18</float><float name="CameraMinZoomDistance">0.5</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000000000000000000000070000E64"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000000000000000000000070000E65"><Properties><string name="Name">ProjectNullClient_V10</string><ProtectedString name="Source">-- PROJECT: NULL — one operator HUD, character dialogue, journal and local effects.
-- All gameplay changes are requests. The server owns experiments, health and saves.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", 30)
local remotes = ReplicatedStorage:WaitForChild("ProjectNullV10", 30)
if not playerGui or not remotes then
    warn("PROJECT: NULL V10: interface services did not appear")
    return
end
local request = remotes:WaitForChild("Request", 15)
local push = remotes:WaitForChild("Push", 15)
if not request or not push or not request:IsA("RemoteEvent") or not push:IsA("RemoteEvent") then return end

local oldGui = playerGui:FindFirstChild("ProjectNullV10")
if oldGui then oldGui:Destroy() end
for _, effectName in ipairs({"ProjectNullV10_Grade", "ProjectNullV10_Blur"}) do
    local effect = Lighting:FindFirstChild(effectName)
    if effect then effect:Destroy() end
end
local oldSounds = SoundService:FindFirstChild("ProjectNullV10_Audio")
if oldSounds then oldSounds:Destroy() end

local function make(className, parent, properties)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end
local C = {
    background = Color3.fromRGB(13, 23, 29),
    surface = Color3.fromRGB(23, 37, 45),
    raised = Color3.fromRGB(32, 49, 58),
    border = Color3.fromRGB(68, 91, 102),
    text = Color3.fromRGB(225, 235, 237),
    muted = Color3.fromRGB(161, 183, 191),
    cyan = Color3.fromRGB(85, 207, 213),
    amber = Color3.fromRGB(232, 183, 96),
    red = Color3.fromRGB(231, 112, 102),
    green = Color3.fromRGB(130, 208, 168),
}
local PROTOCOLS = {
    P01 = "СЕНСОРНАЯ СИНХРОНИЗАЦИЯ",
    P02 = "НАРУШЕНИЕ ВОСПРИЯТИЯ",
    P03 = "ПАМЯТЬ И РЕКОНСТРУКЦИЯ",
    P04 = "АВТОНОМНЫЙ НАБЛЮДАТЕЛЬ",
    P05 = "ГРАНИЦА СИМУЛЯЦИИ",
}
local PHASES = {
    idle = "ОЖИДАНИЕ", prepared = "ПОДГОТОВЛЕНО", running = "ИСПЫТАНИЕ",
    completed = "ЗАВЕРШЕНО", failed = "ОСТАНОВЛЕНО", calibrating = "КАЛИБРОВКА",
}
local snapshot = {phase = "idle", telemetry = {}, profile = {}}
local currentModal, lastContextKey = nil, ""
local documents, dialogueCache = {}, {}
local muted, reducedEffects = false, false
local uiWidth, uiHeight, bodyWidth = 800, 600, 660
local lastRequest = {}
local lastCueKey, lastPhase = "", ""
local modalSignature, cueSignature = "", ""
local noticeUntil = 0
local connections = {}
local activeTweens = setmetatable({}, {__mode = "k"})
local dialoguePending, dialogueWaitUntil = false, 0
local dialogueButtons = {}

-- The same client works with the preserved V10 file and the expanded ship.
local worldRooms = {}
local configModule = remotes:FindFirstChild("WorldConfig")
if configModule and configModule:IsA("ModuleScript") then
    local ok, config = pcall(require, configModule)
    if ok and type(config) == "table" and type(config.rooms) == "table" then worldRooms = config.rooms end
end

local screen = make("ScreenGui", playerGui, {
    Name = "ProjectNullV10", ResetOnSpawn = false, IgnoreGuiInset = false,
    DisplayOrder = 40, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})
local root = make("Frame", screen, {Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1})
local function corner(object, radius) make("UICorner", object, {CornerRadius = UDim.new(0, radius or 6)}) end
local function border(object, color)
    return make("UIStroke", object, {Color = color or C.border, Thickness = 1, Transparency = 0.2})
end
local function animate(object, properties, duration)
    local previous = activeTweens[object]
    if previous then pcall(function() previous:Cancel() end) end
    local ok, tween = pcall(function()
        return TweenService:Create(object, TweenInfo.new(duration or .14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    end)
    if ok then
        activeTweens[object] = tween
        tween:Play()
    else
        for key, value in pairs(properties) do object[key] = value end
    end
end
local function label(parent, text, size, color, height)
    local item = make("TextLabel", parent, {
        Name = "Text", BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 24), Text = tostring(text or ""),
        TextSize = size or 15, Font = Enum.Font.Code, TextColor3 = color or C.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, RichText = false,
    })
    return item
end
local function block(parent, text, size, color)
    local value = tostring(text or "")
    local textSize = size or 15
    local measured = TextService:GetTextSize(value, textSize, Enum.Font.Code, Vector2.new(math.max(180, bodyWidth), 10000))
    return label(parent, value, textSize, color, math.max(textSize + 6, measured.Y + 8))
end
local function send(action, argument)
    local now = os.clock()
    if now - (lastRequest[action] or -10) &lt; 0.18 then return false end
    lastRequest[action] = now
    request:FireServer(action, argument)
    return true
end
local function button(parent, text, callback, color)
    local item = make("TextButton", parent, {
        Name = "Action", Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.raised,
        BorderSizePixel = 0, Text = text, Font = Enum.Font.Code, TextSize = 14,
        TextColor3 = color or C.text, AutoButtonColor = false, TextWrapped = true, RichText = false,
    })
    corner(item, 4)
    border(item, C.border)
    local function highlight()
        if item.Active ~= false then animate(item, {BackgroundColor3 = C.surface}, .12) end
    end
    local function restore() animate(item, {BackgroundColor3 = C.raised}, .12) end
    item.MouseEnter:Connect(highlight)
    item.MouseLeave:Connect(restore)
    item.SelectionGained:Connect(highlight)
    item.SelectionLost:Connect(restore)
    item.Activated:Connect(function()
        if item.Active ~= false then callback() end
    end)
    item.Destroying:Connect(function()
        local tween = activeTweens[item]
        if tween then pcall(function() tween:Cancel() end) end
        activeTweens[item] = nil
    end)
    return item
end
local function enabled(item, value)
    item.Active = value
    item.Selectable = value
    item.AutoButtonColor = false
    item.TextTransparency = value and 0 or 0.58
    item.BackgroundTransparency = value and 0 or 0.45
end
local function clear(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then child:Destroy() end
    end
end
local function owned()
    local owner = snapshot.owner
    return owner == nil or owner == 0 or owner == player.UserId
end
local function finite(value, fallback)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return fallback end
    return value
end
local function clamp(value, low, high) return math.max(low, math.min(high, value)) end
local function tableCount(value)
    local count = 0
    if type(value) == "table" then for _ in pairs(value) do count = count + 1 end end
    return count
end
local function stringify(value)
    if type(value) ~= "table" then return tostring(value or "") end
    local lines = {}
    for key, item in pairs(value) do
        if type(item) ~= "table" then table.insert(lines, tostring(key) .. ": " .. tostring(item)) end
    end
    table.sort(lines)
    return table.concat(lines, "\n")
end

-- These short sounds are shipped with Roblox; no uploaded asset ID or HTTP request.
local audioFolder = make("Folder", SoundService, {Name = "ProjectNullV10_Audio"})
local cueSound = make("Sound", audioFolder, {
    Name = "Cue", SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.16,
})
local clickSound = make("Sound", audioFolder, {
    Name = "Relay", SoundId = "rbxasset://sounds/switch.wav", Volume = 0.12,
})
local grade = make("ColorCorrectionEffect", Lighting, {
    Name = "ProjectNullV10_Grade", Enabled = true, Brightness = 0, Contrast = 0,
    Saturation = 0, TintColor = Color3.new(1, 1, 1),
})
local blur = make("BlurEffect", Lighting, {Name = "ProjectNullV10_Blur", Size = 0, Enabled = true})
local function play(sound)
    if not muted then
        -- Missing local audio must never interrupt the operator interface.
        pcall(function() sound:Play() end)
    end
end

local status = make("Frame", root, {
    Name = "LocalStatus", Position = UDim2.fromOffset(12, 12),
    Size = UDim2.fromOffset(302, 76), BackgroundColor3 = C.background, BackgroundTransparency = .1,
})
corner(status); border(status)
make("Frame", status, {Name = "IdentityRail", Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = C.cyan, BorderSizePixel = 0})
local locationText = label(status, "КОМПЛЕКС / ОПРЕДЕЛЕНИЕ ЗОНЫ", 12, C.cyan, 24)
locationText.Name = "StationLocation"
locationText.Position = UDim2.fromOffset(12, 9)
locationText.Size = UDim2.new(1, -24, 0, 24)
local healthText = label(status, "СОСТОЯНИЕ ПЕРСОНАЖА —", 12, C.muted, 19)
healthText.Name = "CharacterHealth"
healthText.Position = UDim2.fromOffset(12, 36)
healthText.Size = UDim2.new(1, -24, 0, 19)
local healthTrack = make("Frame", status, {
    Position = UDim2.fromOffset(12, 61), Size = UDim2.new(1, -24, 0, 4),
    BackgroundColor3 = C.raised, BorderSizePixel = 0,
})
local healthFill = make("Frame", healthTrack, {
    Name = "HealthFill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, BorderSizePixel = 0,
})

local hud = make("Frame", root, {
    Name = "Telemetry", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
    Size = UDim2.fromOffset(300, 188), BackgroundColor3 = C.background, BackgroundTransparency = 0.1,
})
corner(hud); border(hud)
make("UIPadding", hud, {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10)})
local hudTitle = label(hud, "PROJECT: NULL / B2", 13, C.cyan, 20)
local hudPhase = label(hud, "ОЖИДАНИЕ СИСТЕМЫ", 13, C.muted, 20)
hudPhase.Position = UDim2.fromOffset(0, 23)
local hudObjective = label(hud, "Подойдите к посту подготовки E-01. Удерживайте E для взаимодействия.", 12, C.text, 56)
hudObjective.Position = UDim2.fromOffset(0, 46)
local meterY = 107
local function meter(title, offset)
    local text = label(hud, title, 12, C.muted, 18)
    text.Position = UDim2.fromOffset(0, offset)
    local track = make("Frame", hud, {
        Position = UDim2.new(0, 0, 0, offset + 19), Size = UDim2.new(1, 0, 0, 4),
        BackgroundColor3 = C.raised, BorderSizePixel = 0,
    })
    local fill = make("Frame", track, {Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.cyan, BorderSizePixel = 0})
    return text, fill
end
local temperatureText, temperatureFill = meter("ТЕМПЕРАТУРА —", meterY)
local stressText, stressFill = meter("НАГРУЗКА —", meterY + 32)

local quick = make("Frame", root, {
    Name = "QuickControls", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12),
    Size = UDim2.fromOffset(386, 38), BackgroundTransparency = 1,
})
make("UIListLayout", quick, {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder})
local openModal, renderModal
local journalButton = button(quick, "ЖУРНАЛ [J]", function()
    if currentModal and currentModal.kind == "journal" then
        currentModal = nil
        send("close")
    else
        if currentModal and currentModal.kind == "npc" then send("close") end
        dialoguePending = false
        currentModal = {kind = "journal", title = "ЛИЧНЫЙ ЖУРНАЛ"}
    end
    modalSignature = ""
    if renderModal then renderModal() end
end, C.cyan)
local muteButton
muteButton = button(quick, "ЗВУК: ВКЛ", function()
    muted = not muted
    cueSound.Volume = muted and 0 or 0.16
    clickSound.Volume = muted and 0 or 0.12
    if muted then cueSound:Stop(); clickSound:Stop() end
    muteButton.Text = muted and "ЗВУК: ВЫКЛ" or "ЗВУК: ВКЛ"
end)
local effectsButton
effectsButton = button(quick, "ЭФФЕКТЫ: ВКЛ", function()
    reducedEffects = not reducedEffects
    effectsButton.Text = reducedEffects and "ЭФФЕКТЫ: ВЫКЛ" or "ЭФФЕКТЫ: ВКЛ"
end)
for index, item in ipairs({journalButton, muteButton, effectsButton}) do
    item.LayoutOrder = index
    item.Size = UDim2.new(1 / 3, -4, 1, 0)
end

local toast = make("TextLabel", root, {
    Name = "Notice", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
    Size = UDim2.fromOffset(500, 48), BackgroundColor3 = C.surface, BackgroundTransparency = 0.05,
    Font = Enum.Font.Code, TextSize = 14, TextColor3 = C.amber, TextWrapped = true,
    RichText = false, Visible = false, ZIndex = 12,
})
corner(toast); border(toast, C.amber)
local function notice(text, level)
    toast.Text = tostring(text or "")
    local warning = level == "warning" or level == "error"
    toast.TextColor3 = warning and C.red or C.amber
    toast.BackgroundColor3 = warning and C.background or C.surface
    toast.Visible = toast.Text ~= ""
    noticeUntil = os.clock() + 5
end

local fallbackRooms = {
    {id="E01",label="Подготовка",bounds={-16,16,-67,-38,-76,-48}},
    {id="E02",label="Шлюз",bounds={-8,8,-67,-38,-48,-24}},
    {id="E03",label="Погружение",bounds={-24,24,-67,-35,-24,24}},
    {id="E04",label="Операторская",bounds={-64,-24,-67,-38,-12,12}},
    {id="E05",label="Восстановление",bounds={40,80,-67,-38,-24,8}},
    {id="E06",label="Медицинский пост",bounds={46,74,-67,-38,-70,-46}},
    {id="E07",label="Калибровка",bounds={-58,-30,-67,-38,-60,-36}},
    {id="E08",label="Чистые материалы",bounds={46,78,-67,-38,51,79}},
    {id="E09",label="Снятое оборудование",bounds={-52,-32,-67,-38,54,70}},
    {id="E10",label="Физический зал",bounds={126,182,-67,-38,-36,36}},
    {id="E11",label="Подготовка испытаний",bounds={138,170,-67,-38,-76,-48}},
    {id="E12",label="Управление залом",bounds={186,218,-67,-38,-12,12}},
    {id="E13",label="Хранение модулей",bounds={134,174,-67,-38,56,88}},
    {id="E16",label="Аппаратная",bounds={-16,16,-67,-38,51,75}},
}
local function inRoom(position, room)
    local bounds = room.bounds
    return type(bounds) == "table" and #bounds == 6
        and position.X &gt;= bounds[1] and position.X &lt;= bounds[2]
        and position.Y &gt;= bounds[3] and position.Y &lt;= bounds[4]
        and position.Z &gt;= bounds[5] and position.Z &lt;= bounds[6]
end
local wasCritical, lastHealthRatio = false, -1
local function refreshLocalStatus()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local bodyRoot = character and character:FindFirstChild("HumanoidRootPart")
    if bodyRoot and bodyRoot:IsA("BasePart") then
        local position = bodyRoot.Position
        local found
        for _, rooms in ipairs({worldRooms, fallbackRooms}) do
            for _, room in ipairs(rooms) do
                if type(room) == "table" and inRoom(position, room) then found = room; break end
            end
            if found then break end
        end
        local deck = position.Y &gt; -35 and "ВЕРХНЯЯ ПАЛУБА" or "ЛАБОРАТОРНЫЙ УРОВЕНЬ"
        if found then
            locationText.Text = tostring(found.id or "ОТСЕК") .. " / " .. tostring(found.label or found.name or deck)
        elseif position.X &gt;= -150 and position.X &lt;= -93 and position.Y &lt; -25 then
            locationText.Text = "СЛУЖЕБНЫЙ ТРАП / ПЕРЕХОД УРОВНЕЙ"
        elseif position.Y &lt; -70 then
            locationText.Text = "ЗАБОРТНАЯ ЗОНА / ВНЕ ПОМЕЩЕНИЙ"
        else
            locationText.Text = deck .. " / ОБЩИЙ МАРШРУТ"
        end
    else
        locationText.Text = "КОМПЛЕКС / ОЖИДАНИЕ ПЕРСОНАЖА"
    end
    local health = humanoid and finite(humanoid.Health, nil)
    local maximum = humanoid and finite(humanoid.MaxHealth, nil)
    if health and maximum and maximum &gt; 0 then
        local ratio = clamp(health / maximum, 0, 1)
        local critical = ratio &gt; 0 and ratio &lt;= .3
        healthText.Text = health &lt;= 0 and "НЕТ ПУЛЬСА / ОЖИДАНИЕ ВОССТАНОВЛЕНИЯ"
            or string.format("%s / ЗДОРОВЬЕ %.0f / %.0f", critical and "ТРЕБУЕТСЯ ПОМОЩЬ" or "СОСТОЯНИЕ СТАБИЛЬНО", health, maximum)
        healthText.TextColor3 = ratio &lt;= .3 and C.red or C.muted
        healthFill.BackgroundColor3 = ratio &lt;= .3 and C.red or C.green
        if math.abs(ratio - lastHealthRatio) &gt; .001 then
            animate(healthFill, {Size = UDim2.fromScale(ratio, 1)}, .2)
            lastHealthRatio = ratio
        end
        if critical and not wasCritical then notice("Состояние ухудшилось. После остановки серии обратитесь в E06.", "warning") end
        wasCritical = critical
    else
        healthText.Text = "СОСТОЯНИЕ ПЕРСОНАЖА —"
        healthFill.Size = UDim2.fromScale(0, 1)
        lastHealthRatio = -1
        wasCritical = false
    end
end

