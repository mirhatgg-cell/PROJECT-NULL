local modalFoot = label(modal, "СЛЕДУЙТЕ ПРОТОКОЛУ · E — ВЗАИМОДЕЙСТВИЕ · J — ЖУРНАЛ", 11, C.muted, 24)
modalFoot.Position = UDim2.new(0, 18, 1, -31)
