rties></Item><Item class="Part" referent="RBX00000000000000000000000000001F94"><Properties><string name="Name">BedPowerConduit</string><Vector3 name="size"><X>0.22</X><Y>0.22</Y><Z>34.0</Z></Vector3><CoordinateFrame name="CFrame"><X>70.0</X><Y>-66.0</Y><Z>22.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">4284643204</Color3uint8><token name="Material">256</token></Properties></Item></Item></Item><Item class="StringValue" referent="RBX000000000000000000000000000003EB"><Properties><string name="Name">README</string><string name="Value">v4 / F02: coupled-field system identification. Three cross-coupled compensators, noisy stationary measurements, sample revision/freshness checks and 8-second stability verification. Future-science fiction implemented as a numerical model, not actual neural technology. Start at E10, read wall protocol, measure three probes, tune compensation, remeasure, validate. Studio runtime not verified.
V5 placement audit: north operator workstation moved clear of wall; compact door controllers; shared airlock doorway pairs; bounded hinged covers; continuous 0.2-stud navigation stripes. F02 research protocol retained. Spatial checks do not replace runtime inspection in Studio.
V6: переработка интерьеров. Кресла, медицинские шасси, регулировка спинки, занятость зоны, питание, закрытые подполные трассы. Это сектор B2, не весь комплекс. Проверка Studio обязательна.</string></Properties></Item><Item class="Folder" referent="RBX000000000000000000000000000003EC"><Properties><string name="Name">Controls</string></Properties><Item class="Folder" referent="RBX000000000000000000000000000003ED"><Properties><string name="Name">Circuits</string></Properties><Item class="BoolValue" referent="RBX000000000000000000000000000003EE"><Properties><string name="Name">Computers</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003EF"><Properties><string name="Name">Ventilation</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003F0"><Properties><string name="Name">AcousticAmplifiers</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003F1"><Properties><string name="Name">Door_01</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000045C"><Properties><string name="Name">Door_02</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000059D"><Properties><string name="Name">Door_05</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000608"><Properties><string name="Name">Door_06</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000673"><Properties><string name="Name">Door_07</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000006DE"><Properties><string name="Name">Door_08</string><bool name="Value">true</bool></Pro