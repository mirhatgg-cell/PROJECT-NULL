-- This module contains no Roblox services. Only the server may mutate its state.
local Engine = {}

local MAX_SUPPLY = 12
local MAX_RECORDS = 12
local TITLES = {
    P01 = "Сенсорная синхронизация",
    P02 = "Нарушение восприятия",
    P03 = "Память и реконструкция",
    P04 = "Автономный наблюдатель",
    P05 = "Граница симуляции",
}
local REQUIREMENTS = {
    P01 = {"Computers", "Ventilation", "AcousticAmplifiers"},
    P02 = {"Computers", "Ventilation", "PhysicalHall"},
    P03 = {"Computers", "Ventilation"},
    P04 = {"Computers", "Ventilation", "PhysicalHall"},
    P05 = {"Computers", "Ventilation", "AcousticAmplifiers", "PhysicalHall"},
}
local CIRCUIT_NAMES = {
    Computers = "вычислители", Ventilation = "вентиляция",
    AcousticAmplifiers = "усилители", PhysicalHall = "питание физического стенда",
}

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copy(item) end
    return result
end

local function clock(state, now)
    if finite(now) then state.now = math.max(state.now, now) end
    return state.now
end

local function actorValid(actor)
    -- Studio Start Server assigns negative UserIds to its real test Players.
    -- Zero alone is the public "no owner" sentinel. The server authenticates
    -- the actual Player instance before passing this trusted identifier here.
    return finite(actor) and actor ~= 0 and actor % 1 == 0
end

local function options(...)
    local values, result = {...}, {}
    for i = 1, #values, 2 do
        table.insert(result, {id = values[i], label = values[i + 1]})
    end
    return result
end

local function circuitProblem(state)
    for _, id in ipairs(REQUIREMENTS[state.experiment]) do
        if state.inputs[id] ~= true then return "Отключено: " .. CIRCUIT_NAMES[id] end
    end
    if state.inputs.ownerPresent == false then return "Оператор покинул испытание или потерял сознание" end
    return nil
end

local function prepareProblem(state)
    local problem = circuitProblem(state)
    if problem then return problem end
    if not state.cooling then return "Включите охлаждение на сервисном посту" end
    if state.temperature &gt; 45 then return "Дождитесь охлаждения ниже 45 °C" end
    if state.integrity &lt; 30 then return "Отремонтируйте стенд: исправность ниже 30%" end
    return nil
end

local function record(state, status, result)
    local item = {
        experiment = state.experiment, title = TITLES[state.experiment], status = status,
        result = result, owner = state.owner or 0,
        elapsed = math.floor(math.max(0, state.now - (state.startedAt or state.now)) * 10 + .5) / 10,
        rounds = math.max(0, state.round - (status == "completed" and 0 or 1)),
        temperature = math.floor(state.peakTemperature * 10 + .5) / 10,
        quality = status == "completed" and math.floor(clamp(100 - state.stress * .3, 0, 100)) or 0,
    }
    table.insert(state.records, item)
    while #state.records &gt; MAX_RECORDS do table.remove(state.records, 1) end
    return item
end

local function failed(state, reason, damage)
    state.phase = "failed"
    state.result = reason
    state.cue = nil
    state.stress = clamp(state.stress + 15, 0, 100)
    state.integrity = clamp(state.integrity - 6, 0, 100)
    local item = record(state, "failed", reason)
    if damage and damage &gt; 0 and state.owner then
        table.insert(state.pendingEvents, {
            kind = "damage", owner = state.owner, amount = clamp(damage, 0, 12), reason = reason,
        })
    end
    return {kind = "failed", owner = state.owner or 0, experiment = state.experiment, result = reason, record = copy(item)}
end

-- Every cue carries observable evidence. Its private answer never enters snapshots.
local function cueFor(state)
    local round, id = state.round, state.experiment
    if id == "P01" then
        local sequence = {{"A", "A"}, {"B", "B"}, {"C", "A"}, {"B", "C"}, {"C", "C"}}
        local pair = sequence[round]
        if not pair then return nil end
        local frequencies = {A = 440, B = 660, C = 880}
        return {
            kind = "sync", label = "Сравните световой канал с акустическим. Подтвердите канал только при совпадении; иначе отклоните импульс.",
            visual = pair[1], audio = pair[2], frequency = frequencies[pair[2]],
            evidence = "Акустическая калибровка: A = 440 Гц; B = 660 Гц; C = 880 Гц. Текстовый канал дублирует звук.",
            options = options("A", "Канал A", "B", "Канал B", "C", "Канал C", "reject", "Отклонить импульс"),
            answer = pair[1] == pair[2] and pair[1] or "reject", preview = 2.0, window = 10.0,
        }
    elseif id == "P02" then
        local sequence = {
            {6, {9.2, 6.0, 3.5}, {"БЛИЗКО", "ДАЛЕКО", "ЦЕЛЬ"}},
            {8, {8.0, 4.0, 11.0}, {"ЗАКРЫТО", "ЦЕЛЬ", "ОБХОД"}},
            {5, {7.5, 8.5, 5.0}, {"ЦЕЛЬ", "ОБХОД", "ДАЛЕКО"}},
            {7, {10.0, 7.0, 2.5}, {"ВЫХОД", "ЗАКРЫТО", "ЦЕЛЬ"}},
        }
        local data = sequence[round]
        if not data then return nil end
        local keys = {"left", "center", "right"}
        local answer, minimum = keys[1], math.huge
        for i, value in ipairs(data[2]) do
            local difference = math.abs(value - data[1])
            if difference &lt; minimum then answer, minimum = keys[i], difference end
        end
        return {
            kind = "measurement", label = "Оптические вывески смещены. Выберите путь по независимому лазерному измерению, совпадающему с заданием.",
            targetDistance = data[1], measurements = copy(data[2]), signs = copy(data[3]),
            evidence = string.format("Задание: %.1f stud. Лазер — слева %.1f; по центру %.1f; справа %.1f.", data[1], data[2][1], data[2][2], data[2][3]),
            options = options("left", "Левый путь", "center", "Центральный путь", "right", "Правый путь"),
            answer = answer, preview = 1.5, window = round == 1 and 25.0 or 20.0,
        }
    elseif id == "P03" then
        local sequence = {"manual", "exhaust", "safe", "transfer"}
        if not sequence[round] then return nil end
        return {
            kind = "reconstruction", label = "Восстановите события по независимому журналу обслуживания. Официальное резюме об автоматическом отключении не подтверждено.",
            evidence = "Подписанный журнал: 03:14 — усилители отключены вручную; 03:16 — восстановлена вытяжка; 03:18 — камера переведена в безопасный режим; 03:21 — испытуемый передан в E-05.",
            reconstructionStep = round,
            options = options("safe", "Безопасный режим камеры", "transfer", "Передача в E-05", "manual", "Ручное отключение усилителей", "exhaust", "Восстановление вытяжки"),
            answer = sequence[round], preview = 1.0, window = 18.0,
        }
    elseif id == "P04" then
        local sequence = {"tracking", "occluded", "tracking", "occluded", "adapting", "occluded"}
        local mode = sequence[round]
        if not mode then return nil end
        local movingAllowed = mode == "occluded"
        local holdDuration = mode == "adapting" and 4 or 2
        return {
            kind = "observer", label = movingAllowed and "Шторка закрыта. Сделайте настоящий шаг рядом с пультом, затем подтвердите проход." or string.format("Оптика открыта. Не двигайтесь %d секунды после сигнала, затем подтвердите остановку.", holdDuration),
            observerMode = mode, observerMemory = state.observerMoves,
            movementRequired = movingAllowed, holdDuration = movingAllowed and 0 or holdDuration,
            evidence = mode == "adapting" and "После двух проходов наблюдатель продлил открытое сканирование. Его память — два последних прохода; сквозь закрытую шторку он не видит." or "Правило: открытая оптика — стоять; закрытая шторка — двигаться. Наблюдатель реагирует на открытое движение, а не угадывает намерение.",
            options = options("hold", "Замереть", "move", "Пройти сектор"),
            answer = movingAllowed and "move" or "hold", preview = 2.0, window = 9.0,
        }
    elseif id == "P05" then
        local sequence = {
            {10.00, 10.08, "stable"}, {12.00, 13.10, "stable"},
            {9.00, 8.95, "unstable"}, {8.00, 8.05, "stable"}, {15.00, 14.10, "stable"},
        }
        local data = sequence[round]
        if not data then return nil end
        local answer = data[3] ~= "stable" and "repeat" or (math.abs(data[1] - data[2]) &gt; .2 and "isolate" or "accept")
        return {
            kind = "boundary", label = "Сопоставьте виртуальную телеметрию с независимым физическим каналом. Допуск 0,20. При нестабильном эталоне повторите измерение.",
            virtualReading = data[1], physicalReading = data[2], referenceQuality = data[3], tolerance = .2,
            evidence = string.format("Терминал: %.2f; независимый канал: %.2f. Эталон: %s.", data[1], data[2], data[3] == "stable" and "стабилен" or "НЕСТАБИЛЕН"),
            options = options("accept", "Принять совпадение", "isolate", "Изолировать расхождение", "repeat", "Повторить измерение"),
            answer = answer, preview = 1.5, window = 14.0,
        }
    end
    return nil
end

local function nextCue(state)
    local cue = cueFor(state)
    if not cue then
        state.phase = "completed"
        state.round = state.totalRounds
        state.progress = 1
        state.cue = nil
        state.result = state.experiment == "P05"
            and "Независимая проверка завершена; расхождения изолированы. Происхождение NULL этим испытанием не установлено."
            or "Протокол выполнен. Измерения и действия оператора записаны."
        local item = record(state, "completed", state.result)
        return {kind = "completed", owner = state.owner or 0, experiment = state.experiment, result = state.result, record = copy(item)}
    end
    cue.readyAt = state.now + cue.preview
    cue.deadline = cue.readyAt + cue.window
    state.cue = cue
    state.observerMotionObserved = false
    state.progress = (state.round - 1) / state.totalRounds
    return nil
end

function Engine.new()
    return {
        phase = "idle", experiment = "P01", owner = nil, now = 0, preparedAt = 0,
        temperature = 24, peakTemperature = 24, stress = 0, dose = 0, integrity = 100,
        cooling = true, supply = MAX_SUPPLY, attempts = 0, round = 0, totalRounds = 5,
        progress = 0, records = {}, pendingEvents = {}, result = "", cue = nil,
        observerMoves = 0, observerMotionObserved = false,
        inputs = {Computers = true, Ventilation = true, AcousticAmplifiers = true, PhysicalHall = true, ownerPresent = true, ownerMoving = false},
    }
end

function Engine.setInputs(state, inputs)
    if type(inputs) ~= "table" then return end
    for key in pairs(state.inputs) do
        if type(inputs[key]) == "boolean" then state.inputs[key] = inputs[key] end
    end
end

function Engine.dispatch(state, action, arg, now, actorId)
    clock(state, now)
    if not actorValid(actorId) then return false, "Недействительный оператор" end
    if type(action) ~= "string" or #action &gt; 24 then return false, "Неизвестное действие" end
    local owns = not state.owner or state.owner == actorId
    if action == "cooling" then
        if type(arg) ~= "boolean" then return false, "Ожидается положение охлаждения" end
        state.cooling = arg
        return true, arg and "Охлаждение включено" or "Охлаждение отключено", {kind = "cooling", enabled = arg, owner = actorId}
    elseif action == "resupply" then
        if state.phase == "running" then return false, "Запас пополняют при остановленном испытании" end
        if state.supply &gt;= MAX_SUPPLY then return false, "Запас полон" end
        local amount = math.min(6, MAX_SUPPLY - state.supply)
        state.supply = state.supply + amount
        return true, "Получены расходные материалы", {kind = "resupply", owner = actorId, amount = amount}
    elseif action == "repair" then
        if state.phase == "running" or state.phase == "prepared" then return false, "Сначала остановите и сбросьте испытание" end
        if state.integrity &gt;= 100 then return false, "Стенд исправен" end
        if state.supply &lt; 2 then return false, "Для ремонта нужны 2 комплекта" end
        state.supply = state.supply - 2
        state.integrity = math.min(100, state.integrity + 30)
        return true, "Исправность восстановлена", {kind = "repair", owner = actorId, amount = 30}
    end
    if not owns and not (action == "reset" and state.inputs.ownerPresent == false) then
        return false, "Пульт занят другим оператором"
    end
    if action == "select" then
        if state.phase ~= "idle" then return false, "Сначала завершите и сбросьте текущий протокол" end
        if type(arg) ~= "string" or not TITLES[arg] then return false, "Неизвестный протокол" end
        state.owner = actorId
        state.experiment = arg
        state.inputs.ownerPresent = true
        state.result = ""
        return true, "Выбран " .. arg
    elseif action == "calibrate" then
        if state.phase ~= "idle" then return false, "Калибровка доступна после сброса" end
        local problem = prepareProblem(state)
        if problem then return false, problem end
        if state.supply &lt; 1 then return false, "Нужен комплект калибровки" end
        state.owner = actorId
        state.inputs.ownerPresent = true
        state.supply = state.supply - 1
        state.phase = "prepared"
        state.preparedAt = state.now
        state.result = ""
        return true, "Калибровка принята. Выдержка 2 секунды."
    elseif action == "start" then
        if state.phase ~= "prepared" then return false, "Сначала выполните калибровку" end
        local problem = prepareProblem(state)
        if problem then return false, problem end
        if state.now - state.preparedAt &lt; 2 then return false, "Калибровка ещё не завершена" end
        state.phase = "running"
        state.startedAt = state.now
        state.peakTemperature = state.temperature
        state.attempts = state.attempts + 1
        state.round = 1
        state.totalRounds = ({P01 = 5, P02 = 4, P03 = 4, P04 = 6, P05 = 5})[state.experiment]
        state.observerMoves = 0
        nextCue(state)
        return true, "Испытание запущено", {kind = "started", owner = actorId, experiment = state.experiment}
    elseif action == "respond" then
        if state.phase ~= "running" or not state.cue then return false, "Сейчас нет активного задания" end
        local problem = circuitProblem(state)
        if problem then return false, problem, failed(state, problem, 0) end
        if state.now &gt; state.cue.deadline then
            return false, "Время ответа истекло", failed(state, "Пропущено окно реакции", 4)
        end
        if state.now &lt; state.cue.readyAt then return false, "Подождите начала сигнала" end
        if type(arg) ~= "string" or #arg &gt; 24 then return false, "Недействительный ответ" end
        local known = false
        for _, item in ipairs(state.cue.options) do if item.id == arg then known = true; break end end
        if not known then return false, "Ответ не относится к текущему заданию" end
        if state.experiment == "P04" then
            if state.cue.observerMode ~= "occluded" and state.inputs.ownerMoving then
                return false, "Движение при открытой оптике", failed(state, "Наблюдатель обнаружил движение при открытой оптике", 4)
            end
            if arg == "hold" and arg == state.cue.answer and state.now &lt; state.cue.readyAt + state.cue.holdDuration then
                return false, string.format("Удерживайте неподвижность %d секунды после сигнала", state.cue.holdDuration)
            end
            if arg == "move" and arg == state.cue.answer and not state.observerMotionObserved and not state.inputs.ownerMoving then
                return false, "Сделайте настоящий шаг рядом с пультом при закрытой шторке"
            end
        end
        if arg ~= state.cue.answer then
            return false, "Нарушена процедура", failed(state, "Неверное действие оператора: протокол остановлен", 4)
        end
        if state.experiment == "P04" and arg == "move" then state.observerMoves = state.observerMoves + 1 end
        state.stress = clamp(state.stress - 2, 0, 100)
        state.round = state.round + 1
        local event = nextCue(state)
        return true, event and "Протокол завершён" or "Измерение принято", event
    elseif action == "abort" then
        if state.phase ~= "running" and state.phase ~= "prepared" then return false, "Испытание уже остановлено" end
        return true, "Выполнен безопасный останов", failed(state, "Испытание остановлено оператором", 0)
    elseif action == "reset" then
        if state.phase == "running" then return false, "Сначала выполните безопасный останов" end
        state.phase = "idle"
        state.owner = nil
        state.cue = nil
        state.round = 0
        state.progress = 0
        state.result = ""
        state.startedAt = nil
        state.inputs.ownerPresent = true
        return true, "Пульт сброшен"
    elseif action == "medical" then
        if state.phase == "running" or state.phase == "prepared" then return false, "Медицинская помощь доступна после остановки" end
        if state.supply &lt; 1 then return false, "Медицинский запас исчерпан" end
        state.supply = state.supply - 1
        state.stress = math.max(0, state.stress - 35)
        state.dose = math.max(0, state.dose - 10)
        return true, "Медицинский комплект использован", {kind = "medical", owner = actorId, amount = 25}
    end
    return false, "Неизвестное действие"
end

function Engine.step(state, dt, now)
    clock(state, now)
    dt = finite(dt) and clamp(dt, 0, 2) or 0
    local events = state.pendingEvents
    state.pendingEvents = {}
    local running = state.phase == "running"
    -- Cooling removes more heat as the exchanger rises above ambient. A sound
    -- running loop settles near 42 °C instead of making load thermally invisible.
    local coolingRate = state.cooling and (.18 * math.max(0, state.temperature - 24) + .25) or .25
    local thermalRate = (running and 3.4 or 0) - coolingRate
    state.temperature = clamp(state.temperature + thermalRate * dt, 24, 100)
    state.peakTemperature = math.max(state.peakTemperature, state.temperature)
    if running then
        state.dose = clamp(state.dose + .08 * dt, 0, 100)
        state.stress = clamp(state.stress + (state.temperature &gt;= 60 and 1.8 or .25) * dt, 0, 100)
    else
        state.stress = math.max(0, state.stress - .5 * dt)
    end
    if state.phase == "prepared" or running then
        local problem = circuitProblem(state)
        if problem then
            table.insert(events, failed(state, problem, 0))
        elseif state.temperature &gt;= 80 then
            table.insert(events, failed(state, "Перегрев: сработала тепловая защита", 12))
        elseif running and state.experiment == "P04" and state.cue and state.now &gt;= state.cue.readyAt and state.inputs.ownerMoving then
            if state.cue.observerMode == "occluded" then
                state.observerMotionObserved = true
                if state.now &gt; state.cue.deadline then
                    table.insert(events, failed(state, "Пропущено окно реакции", 4))
                end
            else
                table.insert(events, failed(state, "Наблюдатель обнаружил движение при открытой оптике", 4))
            end
        elseif running and state.cue and state.now &gt; state.cue.deadline then
            table.insert(events, failed(state, "Пропущено окно реакции", 4))
        elseif state.phase == "prepared" and state.now - state.preparedAt &gt; 120 then
            table.insert(events, failed(state, "Срок калибровки истёк", 0))
        end
    end
    -- Include damage queued by a failure detected during this step, once only.
    for _, event in ipairs(state.pendingEvents) do table.insert(events, event) end
    state.pendingEvents = {}
    return events
end

function Engine.snapshot(state, now)
    -- A snapshot is a view, not a clock mutation or a route into private answers.
    local viewTime = finite(now) and math.max(state.now, now) or state.now
    local cue = nil
    if state.cue then
        cue = {}
        for key, value in pairs(state.cue) do
            if key ~= "answer" and key ~= "window" and key ~= "preview" then cue[key] = copy(value) end
        end
        cue.ready = viewTime &gt;= state.cue.readyAt
        cue.remaining = math.max(0, state.cue.deadline - viewTime)
        cue.previewRemaining = math.max(0, state.cue.readyAt - viewTime)
    end
    local requirements = {}
    for _, id in ipairs(REQUIREMENTS[state.experiment]) do
        table.insert(requirements, {id = id, label = CIRCUIT_NAMES[id], enabled = state.inputs[id] == true})
    end
    local objectives = {
        idle = "Выберите протокол на местном пульте и выполните калибровку.",
        prepared = "Дождитесь окончания калибровки и запустите испытание.",
        running = cue and cue.label or "Следуйте протоколу.",
        completed = "Результат записан. Сбросьте пульт перед следующим испытанием.",
        failed = "Устраните причину остановки, при необходимости получите помощь и сбросьте пульт.",
    }
    return {
        phase = state.phase, experiment = state.experiment, title = TITLES[state.experiment], owner = state.owner or 0,
        objective = objectives[state.phase], cue = cue, result = state.result,
        attempts = state.attempts, round = state.round, totalRounds = state.totalRounds,
        calibrationRemaining = state.phase == "prepared" and math.max(0, 2 - (viewTime - state.preparedAt)) or 0,
        telemetry = {
            temperature = state.temperature, stress = state.stress, dose = state.dose, integrity = state.integrity,
            progress = state.progress, cooling = state.cooling, supply = state.supply,
        },
        supply = state.supply, requirements = requirements, records = copy(state.records), serverTime = viewTime,
        recoverable = state.phase ~= "running",
    }
end

return Engine
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000070000E5E"><Properties><string name="Name">Content</string><ProtectedString name="Source">-- V11 server-only narrative data.
return {["documents"]={{["id"]="DOC_SHIFT_HANDOVER",["title"]="Передача смены 04",["room"]="E-01",["body"]="Принимать пост по фактическому состоянию цепей. Сводка прошлого оператора не заменяет измерение. Перед запуском: проверить питание вычислителей, вентиляцию, усилители и контур охлаждения; подготовить нужный пульт и выполнить калибровку.\n\nПосле испытания сохранить протокол на этом посту. Открытые документы остаются в личном журнале. Работы по фильтрам оформляются в E-08, медицинская помощь — в E-06.\n\nПримечание техника: в сводке инцидента 03 ошибочно указан автоматический останов. Подписанный независимый журнал хранится в E-07.",["evidence"]="История раскладывается по постам: официальная сводка E-04, независимая хронология E-07, передача в восстановление E-05.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"История раскладывается по постам: официальная сводка E-04, независимая хронология E-07, передача в восстановление E-05."},["hypotheses"]={}},{["id"]="DOC_ACCESS",["title"]="Порядок допуска к испытанию",["room"]="E-01",["body"]="Один цикл — один ответственный оператор. Второй сотрудник может наблюдать состояние системы, но не подменяет решения владельца текущего цикла.\n\nНе покидать пост во время активного задания. При потере питания, перегреве, потере оператора или нарушении временного окна испытание прерывается с записью причины. Ошибка — причина остановиться и восстановить систему, а не повторять процедуру вслепую.\n\nСохранение фиксирует открытые документы и результаты, но не сохраняет работающий опасный цикл.",["evidence"]="Служебный журнал отделяет успешные результаты от прерванных попыток.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Служебный журнал отделяет успешные результаты от прерванных попыток."},["hypotheses"]={}},{["id"]="DOC_P01_PROTOCOL",["title"]="P-01: сенсорная синхронизация",["room"]="E-04",["body"]="Гипотеза: оператор способен отличить фактический сенсорный сигнал от ожидания следующего сигнала. Используются акустический тракт и нейроинтерфейс камеры E-03.\n\nПодготовка: питание вычислителей, вентиляции и усилителей; включённое охлаждение; калибровка. После запуска следить за текущей подсказкой и её временным окном. Подтверждать именно показанный сигнал. Не нажимать варианты заранее по памяти.\n\nПравильная последовательность снижает расхождение каналов. Неверный ответ или пропуск окна прекращает серию, повышает нагрузку и фиксируется в протоколе.",["evidence"]="На операторском посту заменён кабель: это устранённая неисправность тракта, а не сверхъестественное объяснение показаний.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"На операторском посту заменён кабель: это устранённая неисправность тракта, а не сверхъестественное объяснение показаний."},["hypotheses"]={}},{["id"]="DOC_P02_PROTOCOL",["title"]="P-02: нарушение восприятия",["room"]="E-12",["body"]="Гипотеза: названия маршрутов влияют на решение сильнее независимых измерений. Испытательный зал подаёт пары несогласованных обозначений и измеренных величин.\n\nВыбирать вариант по фактическому условию текущего задания и числовому измерению. Табличка, рекламирующая путь как безопасный или короткий, сама по себе не является доказательством. Значения показываются до принятия решения; скрытой случайной проверки нет.\n\nНе запускать при отключённом питании физического зала. Предыдущая программа зала остаётся самостоятельным испытанием: не совмещать активные циклы.",["evidence"]="Исправленная схема рядом с пультом сохраняет старые подписи, чтобы расхождение можно было заметить.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Исправленная схема рядом с пультом сохраняет старые подписи, чтобы расхождение можно было заметить."},["hypotheses"]={}},{["id"]="DOC_P03_LOG",["title"]="Инцидент 03: официальная сводка",["room"]="E-04",["body"]="Статус: закрыт без замечаний. Защитная автоматика самостоятельно отключила усилители. Вытяжка работала непрерывно. Перевод камеры в безопасный режим выполнен штатно; дальнейшее наблюдение не потребовалось.\n\nПодпись оператора отсутствует. Время формирования сводки: 04:02. Приложения: не приложены.\n\nНа нижнем поле карандашом: «Сравнить с регистратором питания, журналом вентиляции и актом передачи E-05. Этот лист составлен после события». ",["evidence"]="Документ противоречит независимым отметкам времени и листу передачи испытуемого.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Документ противоречит независимым отметкам времени и листу передачи испытуемого."},["hypotheses"]={}},{["id"]="DOC_P03_CORRECTION",["title"]="Инцидент 03: независимая хронология",["room"]="E-07",["body"]="Источник: четыре отдельных регистратора, сверенные по общей часовой метке.\n\n03:14 — усилители отключены вручную.\n03:16 — восстановлена вытяжка.\n03:18 — камера переведена в безопасный режим.\n03:21 — испытуемый передан в E-05.\n\nПодписал: И. Ветров, техник смены. Запись питания подтверждает ручной разрыв цепи; журнал вентиляции фиксирует восстановление, а не непрерывную работу. Акт E-05 подтверждает передачу.\n\nДля P-03 восстанавливать именно этот причинный порядок. Поздняя сводка не является первичным источником.",["evidence"]="Четыре физические кассеты регистратора на столе подписаны теми же временами: 03:14, 03:16, 03:18, 03:21.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Четыре физические кассеты регистратора на столе подписаны теми же временами: 03:14, 03:16, 03:18, 03:21."},["hypotheses"]={}},{["id"]="DOC_P04_PROTOCOL",["title"]="P-04: автономный наблюдатель",["room"]="E-16",["body"]="Система наблюдения не читает мысли. Она работает по ограниченному, объявленному циклу состояний. Текущая инструкция пульта показывает, когда следует удерживать положение, а когда изменять его.\n\nНе переносить ответ с предыдущего шага автоматически. У наблюдателя есть предсказуемая последовательность и временное окно; решение сверяется с объявленным состоянием. Ошибка повышает нагрузку и завершает цикл с причиной.\n\nПроверяется реакция оператора на наблюдение, а не существование неизвестного существа. Природа NULL настоящим протоколом не устанавливается.",["evidence"]="Пульт подключён к той же аппаратной, но не выдаёт доступ ко всем системам комплекса.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Пульт подключён к той же аппаратной, но не выдаёт доступ ко всем системам комплекса."},["hypotheses"]={}},{["id"]="DOC_P05_PROTOCOL",["title"]="P-05: граница симуляции",["room"]="E-03",["body"]="Назначение: обнаружить расхождение виртуального канала и независимого физического эталона. Совпадение проверяется по показаниям, а не по убедительности изображения.\n\nНа каждом шаге сравнить два показания. Выбрать согласованный либо расходящийся канал согласно заданию пульта. Эталон имеет отдельное питание и собственный регистратор; его корпус рядом с камерой допускает осмотр внутренних узлов.\n\nЕсли каналы разошлись, не подгонять физический эталон под экран. Записать расхождение. Успех этой проверки не раскрывает сущность NULL и не даёт разрешение на кульминационный эксперимент.",["evidence"]="Внутри отдельного эталонного прибора видны плата, генератор, аккумулятор и клеммы; корпус не заполнен сплошной геометрией.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Внутри отдельного эталонного прибора видны плата, генератор, аккумулятор и клеммы; корпус не заполнен сплошной геометрией."},["hypotheses"]={}},{["id"]="DOC_OPERATOR",["title"]="Личный журнал оператора Соколовой",["room"]="E-04",["body"]="Третий раз переписываю один и тот же отчёт. В сводке стоит «автоматика», хотя Ветров снимал питание рукой. Если оставить так, следующий оператор будет ждать защиты, которой в тот момент не было.\n\nКружку оставила на старом посту, ключ от кассетного шкафа вернула. Запросила перевод до сверки четырёх регистраторов. Прошу не удалять исходные записи после подготовки красивой сводки.\n\nНа обороте: «Время в отчёте и время события — разные вещи». ",["evidence"]="Пустующий пост и сохранённые кассеты объясняют конфликт персонала без утверждения его окончательной судьбы.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Пустующий пост и сохранённые кассеты объясняют конфликт персонала без утверждения его окончательной судьбы."},["hypotheses"]={}},{["id"]="DOC_RECOVERY",["title"]="Акт передачи в восстановление",["room"]="E-05",["body"]="Время приёма: 03:21. Передающая сторона: оператор E-03. Принимающая: Л. Кравцова, медицинское сопровождение.\n\nОснование: прекращение серии после ручного отключения усилителей и восстановления вытяжки. Испытуемому назначено наблюдение; повторный запуск до осмотра не согласован. Личные вещи упакованы отдельно, номер комплекта совпадает с записью передачи.\n\nСводка «дальнейшее наблюдение не потребовалось» фактическому акту не соответствует.",["evidence"]="Два отдельных контейнера на тележке содержат сложенную одежду и блокнот, а не пустую наружную оболочку.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Два отдельных контейнера на тележке содержат сложенную одежду и блокнот, а не пустую наружную оболочку."},["hypotheses"]={}},{["id"]="DOC_MISSING_SHIFT",["title"]="Незакрытый лист смены",["room"]="E-05",["body"]="Рабочее место 12 освобождено до сверки результатов. Приказ о постоянном переводе в папке отсутствует. Личные вещи не списывать, доступ к исходным журналам сохранить.\n\nВнутренняя переписка: научный отдел требует закрыть серию, медицинское сопровождение — повторно проверить наблюдение после инцидента. Решение руководства в данной папке не приложено.\n\nОтсутствие сотрудника на посту само по себе не объясняет, что с ним произошло.",["evidence"]="Закрытая личная папка и неубранные вещи показывают незавершённую передачу поста.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Закрытая личная папка и неубранные вещи показывают незавершённую передачу поста."},["hypotheses"]={}},{["id"]="DOC_MEDICAL",["title"]="Карта наблюдения и выдачи комплектов",["room"]="E-06",["body"]="После нештатного цикла оценить состояние оператора и испытуемого отдельно. Не менять показания ради закрытия протокола. Успешная проверка оборудования не отменяет последствий предыдущей ошибки.\n\nАптечка выдаёт ограниченный комплект первой помощи. Расход отражается в журнале; повторные попытки не создают бесконечный запас. При недостатке комплектов прекратить рискованные испытания.\n\nДля снятия причины технического отказа требуется обслуживание, а не медицинская помощь.",["evidence"]="На полках аптечки лежат запечатанные комплекты; медицинские и ремонтные расходники хранятся раздельно.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"На полках аптечки лежат запечатанные комплекты; медицинские и ремонтные расходники хранятся раздельно."},["hypotheses"]={}},{["id"]="DOC_CALIBRATION",["title"]="Предписание по калибровке",["room"]="E-07",["body"]="Калибровка подтверждает готовность текущего выбранного испытания. После смены программы подготовить систему заново.\n\nНезависимые журналы не исправлять задним числом. В P-03 порядок событий восстанавливается по отметкам первичных источников: отключение усилителей, восстановление вытяжки, безопасный режим камеры, передача в восстановление.\n\nДля других серий сначала читать текущую задачу: верный ответ предыдущего испытания не переносится автоматически.",["evidence"]="Реконструкция использует причинный порядок, подтверждённый четырьмя регистраторами.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Реконструкция использует причинный порядок, подтверждённый четырьмя регистраторами."},["hypotheses"]={}},{["id"]="DOC_SUPPLY",["title"]="Выдача фильтров и обслуживание",["room"]="E-08",["body"]="Запасные фильтры выдаются по одному с учётом остатка. Полученный фильтр используется при обслуживании контура; получение детали и её установка — разные действия.\n\nРаботы выполнять при остановленном испытании. Не обходить тепловую защиту: сначала восстановить условия охлаждения и заменить расходник, затем сбрасывать отказ.\n\nПричина расхождения складской сводки: один комплект числится в карантине E-09 и не должен возвращаться в чистый запас без проверки.",["evidence"]="Чистый шкаф содержит четыре сменные кассеты; рядом лежит разобранный контроллер на ремонтном столе.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Чистый шкаф содержит четыре сменные кассеты; рядом лежит разобранный контроллер на ремонтном столе."},["hypotheses"]={}},{["id"]="DOC_QUARANTINE",["title"]="Карантин снятого драйвера",["room"]="E-09",["body"]="Драйвер снят после инцидента 03. Не включать, не возвращать в чистый запас. Плату и концы кабеля сохранить для сверки.\n\nНа закупочной ведомости стоит отметка «комплект списан», но приёмки утилизации нет. До выяснения хранить отдельно под номером той же серии.\n\nСлед перегрева подтверждает повреждение узла, но сам по себе не устанавливает первичную причину отказа. Сопоставить с журналом питания E-07.",["evidence"]="На отдельном столе лежит вскрываемый драйвер: потемневшая плата, силовые элементы и обрезанные кабели.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"На отдельном столе лежит вскрываемый драйвер: потемневшая плата, силовые элементы и обрезанные кабели."},["hypotheses"]={}},{["id"]="DOC_HALL_CONTROL",["title"]="Памятка независимого наблюдения",["room"]="E-12",["body"]="При несовпадении названия маршрута и измерения сохранять оба значения. Нельзя переименовать путь и считать проблему устранённой.\n\nP-02 проверяет выбор по измерению. P-05 проверяет согласованность двух независимых каналов. Это разные вопросы: короткий путь не становится достоверным только потому, что так назван; достоверность эталона не определяется красотой виртуальной сцены.\n\nРабочий цикл имеет одного ответственного. При занятом посте дождаться завершения или штатного останова.",["evidence"]="Два операторских места оставлены со своими исходными приборами; новый пульт не закрывает прежние органы управления.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Два операторских места оставлены со своими исходными приборами; новый пульт не закрывает прежние органы управления."},["hypotheses"]={}},{["id"]="DOC_GENERATIONS",["title"]="Переход между поколениями аппаратуры",["room"]="E-13",["body"]="Поколение 01: общий тракт отображения и регистрации. Поколение 02: независимый эталон и отдельный журнал.\n\nЗамена введена после выявления расхождений сводок и первичных записей. Старые эталоны сохраняются как сравнимые образцы, а не используются вместо исправных рабочих модулей.\n\nВ архиве разные цвета корпусов обозначают поколения аппаратуры. Они не обозначают виды неизвестного воздействия и не являются доказательством природы NULL.",["evidence"]="Два шкафа имеют разные поколения папок и приборов; внутри запасных сенсорных модулей есть объектив, плата и накопитель.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Два шкафа имеют разные поколения папок и приборов; внутри запасных сенсорных модулей есть объектив, плата и накопитель."},["hypotheses"]={}},{["id"]="DOC_COOLING",["title"]="Контур охлаждения и защита",["room"]="E-16 / THERM",["body"]="Рабочий цикл нагревает оборудование. Охлаждение снижает температуру только при наличии питания вентиляции и исправного контура. Отключённый контур не компенсируется повторной калибровкой.\n\nНа пульте контролировать температуру и состояние защиты. При перегреве остановить цикл, дать оборудованию остыть и выполнить обслуживание с расходником. Повторный запуск без устранения причины снова приведёт к останову.\n\nМоделируемые в игре показания описывают состояние исследовательского оборудования, а не реальные медицинские процедуры.",["evidence"]="Контур связан с существующим насосным модулем и фанкойлом; контрольный пост находится у аппаратной.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Контур связан с существующим насосным модулем и фанкойлом; контрольный пост находится у аппаратной."},["hypotheses"]={}},{["id"]="DOC_NULL_LIMIT",["title"]="Ограничение программы NULL",["room"]="E-03",["body"]="В этой версии разрешены отдельные проверки P-01 — P-05. Ни одна из них не считается кульминационным экспериментом NULL.\n\nРасхождение приборов, конфликт отчётов и последствия нештатного останова должны расследоваться по источникам. Не присваивать наблюдению окончательное объяснение без достаточных данных.\n\nРаздел «природа NULL» не заполнен. Раздел «решение о следующем этапе программы» оставлен на согласование. Исправления не вносить от имени отсутствующего руководителя.",["evidence"]="Документ оставляет главную тайну открытой и связывает найденные факты без выдуманного окончательного раскрытия.",["author"]="Не указан в исходной записи",["period"]="Рабочая документация комплекса; абсолютная дата не указана",["claims"]={"Документ оставляет главную тайну открытой и связывает найденные факты без выдуманного окончательного раскрытия."},["hypotheses"]={}},{["id"]="DOC_CREW_SHIFT",["title"]="Лист передачи жилой палубы",["room"]="C01",["author"]="Илья Ветров, техник смены",["period"]="Смена 04, после инцидента 03",["body"]="Нижняя палуба занята экспериментальными и медицинскими помещениями. На жилую палубу ведёт западная лестничная клетка; центральная галерея соединяет вахтенный пост, связь и носовую рубку. Держать аварийные маршруты свободными.\n\nЛабораторные протоколы принимаются по прежним постам E-04, E-12, E-07, E-16 и E-03. Перенос людей на верхнюю палубу не означает окончания передачи медицинского сопровождения. Личные вещи с тележки E-05 не выдавать по одной фамилии из сводки: требуется закрытый акт передачи.",["evidence"]="Жилая палуба и лабораторная палуба соединены западной лестницей. Отдельный акт передачи важнее устного сообщения о завершении работ.",["claims"]={"Жилая палуба и лабораторная палуба соединены западной лестницей.","Отдельный акт передачи важнее устного сообщения о завершении работ."},["hypotheses"]={},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_MESS_NOTICE",["title"]="Записка на столе камбуза",["room"]="C02",["author"]="Дежурная группа снабжения",["period"]="После приёма смены 04",["body"]="Чайник не отмечать как неисправный: его отключают на время проверки распределения. Запас чистой воды относится к бытовому контуру, а не к лабораторному охлаждению.\n\nНа обороте чужим почерком: «Вчера у стола снова осталось одно лишнее место. Я не знаю, кто должен был вернуться. Перестаньте вычёркивать фамилии карандашом до конца смены».\n\nЗаписка не содержит фамилии и не подтверждает судьбу отсутствующего сотрудника.",["evidence"]="Бытовая вода и охлаждение лабораторий ведутся раздельно.",["claims"]={"Бытовая вода и охлаждение лабораторий ведутся раздельно."},["hypotheses"]={"Автор приписки ожидал возвращения кого-то из смены; личность и дальнейшая судьба неизвестны."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_HYGIENE",["title"]="Маршрут чистых и использованных комплектов",["room"]="C03",["author"]="Лидия Кравцова, медицинское сопровождение",["period"]="Рабочая инструкция текущей смены",["body"]="Бытовой санитарный отсек не заменяет медицинский пост E-06. Рабочие перчатки и использованные технические комплекты не возвращать в чистый склад E-08. Маркировка использованных изделий ведётся через E-09.\n\nСотрудник после остановленного испытания сначала получает запись о причине остановки. Снятие рабочей одежды само по себе не подтверждает нормальное состояние участника. Решение о повторной серии нельзя делать по зелёному индикатору прибора.",["evidence"]="Бытовая гигиена и медицинский допуск имеют разные функции. Исправность прибора не подтверждает состояние человека.",["claims"]={"Бытовая гигиена и медицинский допуск имеют разные функции.","Исправность прибора не подтверждает состояние человека."},["hypotheses"]={},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_SECURITY_WATCH",["title"]="Вахтенный лист доступа",["room"]="C04",["author"]="Артём Громов, вахтенный безопасности",["period"]="Смена 04",["body"]="Объект автономный, океанический. Наружная обстановка не должна оцениваться по одному каналу наблюдения. Центральная галерея и западная лестница остаются маршрутами сотрудников; оборудование и контейнеры на них не складировать.\n\nРежим содержания испытуемых не даёт права исправлять их медицинские записи. Участники программы — заключённые; запись о выполненном протоколе не является записью о согласии.\n\nВ локальной сводке инцидента стоят технические формулировки. Вахта подтверждает только передачу по оформленному маршруту, а не причину происшествия.",["evidence"]="В программе участвуют заключённые. Вахта разграничивает технический отчёт, медицинскую запись и маршрут передачи.",["claims"]={"В программе участвуют заключённые.","Вахта разграничивает технический отчёт, медицинскую запись и маршрут передачи."},["hypotheses"]={},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_COMMS_LOG",["title"]="Копия журнала связи: повтор пакета",["room"]="C05",["author"]="Нина Соколова, оператор; копия для вахты",["period"]="Сверка после инцидента 03",["body"]="На основном экране дважды отобразился один и тот же пакет состояния. В буфере доставки находится одна принятая запись и повтор отображения. Этого недостаточно, чтобы утверждать повтор самого события.\n\nПриложение: независимые отметки 03:14, 03:16, 03:18 и 03:21 должны сверяться по регистратору E-07. Копия экрана связи не исправляет первичный журнал.\n\nПометка оператора: «Я видела повтор, но не знаю, где он возник: в доставке, визуализации или в другом звене. Не подписывайте за меня версию о внешнем вмешательстве».",["evidence"]="На отображении замечен повтор пакета; по этой копии нельзя доказать повтор события.",["claims"]={"На отображении замечен повтор пакета; по этой копии нельзя доказать повтор события."},["hypotheses"]={"Причина повтора отображения не установлена."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами",["requires"]={["any"]={{["document"]="DOC_P03_CORRECTION"},{["completed"]="P03"}}}},{["id"]="DOC_SHIP_POWER",["title"]="Схема разделения судового и лабораторного питания",["room"]="C06",["author"]="Марк Белов, инженер контура",["period"]="Действующая схема смены 04",["body"]="Верхний распределительный отсек обслуживает судовые линии и ввод нижней палубы. Рабочими состояниями лабораторий остаются автоматы вычислителей, вентиляции, усилителей и физического зала в существующем щите. Не считать подпись на корпусе подтверждением напряжения.\n\nПосле ручного отключения усилителей вычислители могут оставаться включёнными: это разные цепи. Независимый измеритель P-05 имеет собственный блок питания, однако его данные всё равно требуют проверки качества эталона.\n\nСледы замены кабеля показывают выполненную работу. Они не устанавливают, была ли повреждённая секция причиной первоначального отказа.",["evidence"]="Разные лабораторные цепи могут иметь разные состояния. P-05 отделяет независимое измерение от виртуальной телеметрии.",["claims"]={"Разные лабораторные цепи могут иметь разные состояния.","P-05 отделяет независимое измерение от виртуальной телеметрии."},["hypotheses"]={"Сам по себе ремонт не доказывает первичную причину отказа."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_WATER_BALANCE",["title"]="Разделение водяных контуров",["room"]="C07",["author"]="Марк Белов, инженер контура",["period"]="Рабочая схема судовых систем",["body"]="Бытовое водоснабжение, балласт и охлаждение экспериментального оборудования учитываются раздельно. Здесь находятся фильтры и накопитель судового контура. Проверка бытового запаса не снимает неисправность охлаждения THERM.\n\nТемпературу лабораторной серии сверять по действительному состоянию охлаждения и показаниям пульта. При тепловой защите прекратить серию, дождаться допустимого режима и устранить техническую причину. Запрещено записывать восстановление вытяжки как «непрерывную работу» задним числом.",["evidence"]="У судового и лабораторного водяных контуров разные назначения. Восстановление системы и непрерывная работа — разные состояния.",["claims"]={"У судового и лабораторного водяных контуров разные назначения.","Восстановление системы и непрерывная работа — разные состояния."},["hypotheses"]={},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_ADMIN_INDEX",["title"]="Индекс программы глубокого погружения",["room"]="C08",["author"]="Софья Левина, регистратор смен",["period"]="Текущий индекс программы, XXII век",["body"]="Программа нейроинтерфейсной виртуальной реальности глубокого погружения: в реестре более тысячи экспериментальных симуляций. Счётчик серий обозначает число зарегистрированных запусков, а не число подтверждённых безопасных возвращений.\n\nВ локальном комплекте документов действует обозначение PROJECT: NULL. В одном из концептуальных описаний встречается Project Zero. Реестр не устанавливает, были ли это разные программы или разные названия. Автоматическое переименование записей запрещено до сверки оснований.\n\nДоступный комплект: официальная сводка E-04, независимая хронология E-07, медицинская передача E-05. Отсутствие окончательного заключения не разрешает заменять его удобной гипотезой.",["evidence"]="В программе зарегистрировано более тысячи симуляций. Расхождение названий существует и пока не разрешено.",["claims"]={"В программе зарегистрировано более тысячи симуляций.","Расхождение названий существует и пока не разрешено."},["hypotheses"]={"Связь названий Project Zero и PROJECT: NULL не установлена."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_BALLAST_LOG",["title"]="Лист осмотра балластной насосной",["room"]="C09",["author"]="Марк Белов, инженер контура",["period"]="После технического обхода текущей смены",["body"]="Насосная относится к устойчивости судового объекта и наружным сервисным линиям. Не подключать её маркировку к лабораторному клапану только потому, что корпуса насосов похожи. На стойке оставлена снятая муфта: замена оформлена, повторный осмотр не закрыт.\n\nВ журнале инцидента 03 нет достаточных данных, чтобы назвать балластную систему причиной ошибки погружения. Отсутствие такой записи не доказывает и обратного. Запрос на независимую сверку остаётся в рабочем порядке.",["evidence"]="У балластного и лабораторного контуров разные функции. Повторный осмотр муфты остаётся незакрытым в этой локальной записи.",["claims"]={"У балластного и лабораторного контуров разные функции.","Повторный осмотр муфты остаётся незакрытым в этой локальной записи."},["hypotheses"]={"Связь судовой насосной с первоначальным инцидентом не установлена."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами"},{["id"]="DOC_OBSERVATION",["title"]="Протокол сопоставления наружного и внутреннего канала",["room"]="C10",["author"]="Нина Соколова; подпись о приёме Софьи Левиной",["period"]="Сверка после восстановления хронологии",["body"]="Окно наблюдения даёт прямую видимость ближайшей части наружной конструкции. Экран получает обработанный сигнал. Если силуэт или время на экране не совпали с прямым наблюдением, сначала фиксируются оба канала, положение оператора и состояние эталона.\n\nИз этого различия нельзя автоматически получить доказательство разумного присутствия. Обозначение «Наблюдатель» описывает предмет исследования, а не установленную природу явления.\n\nПриложены ссылки на P-03 и P-05: восстановленная последовательность показывает, что происходило по записям; независимый канал ограничивает ошибку измерения. Ни одна из этих процедур не отвечает за происхождение NULL.",["evidence"]="Прямое наблюдение и обработанный экранный канал рассматриваются раздельно. P-03 и P-05 ограничивают выводы своими условиями.",["claims"]={"Прямое наблюдение и обработанный экранный канал рассматриваются раздельно.","P-03 и P-05 ограничивают выводы своими условиями."},["hypotheses"]={"Природа Наблюдателя не установлена."},["status"]="Локальное дополнение, совместимое с исходными свидетельствами",["requires"]={["any"]={{["completed"]="P03"},{["all"]={{["document"]="DOC_P03_CORRECTION"},{["document"]="DOC_ADMIN_INDEX"}}}}}}},["staff"]={["TECH"]={["name"]="Илья Ветров",["role"]="Техник смены",["lines"]={"Сначала проверь цепи и охлаждение. Если приборы не готовы, калибровка не сделает их исправными.","В отчёте написано, что останов был автоматическим. Я отключал усилители вручную. Четыре регистратора лежат в E-07 — сравни время сам.","Фильтр получают в E-08, там же обслуживают контур. Не путай выдачу запасной детали с выполненным ремонтом.","Пост записи здесь. Сохраняй результаты после серии: начатый опасный цикл не должен возобновляться после возвращения."}},["MEDIC"]={["name"]="Лидия Кравцова",["role"]="Медицинское сопровождение",["lines"]={"Я приняла испытуемого в 03:21. Поэтому строка «наблюдение не потребовалось» в сводке неверна.","Отказ оборудования и состояние человека — разные записи. Исправленный прибор не отменяет последствий ошибки.","Первая помощь есть в E-06. Запас ограничен. Если причина отказа техническая, нужен техник и расходник, а не ещё одна аптечка.","Личные вещи оставлены на тележке до закрытия передачи. Они подтверждают маршрут после испытания, но не объясняют всю программу NULL."}},["OPERATOR"]={["name"]="Нина Соколова",["role"]="Нейрооператор",["lines"]={"Я отвечаю за то, что мы видим на терминале. Не за всё, что произошло за его пределами."}},["ENGINEER"]={["name"]="Марк Белов",["role"]="Инженер контура",["lines"]={"Сначала разделим линии. По цвету трубы нельзя определить, куда она подключена."}},["SECURITY"]={["name"]="Артём Громов",["role"]="Вахтенный безопасности",["lines"]={"Проход свободен. Сначала разберитесь, какой записью подтверждена передача."}},["ARCHIVIST"]={["name"]="Софья Левина",["role"]="Регистратор смен",["lines"]={"Копия — это копия. Я покажу, где лежит исходная запись, но не подпишу за неё вывод."}}},["dialogues"]={["TECH"]={["first"]="Илья Ветров. Принимал нижнюю палубу. До запуска посмотрите щит и охлаждение; я слишком часто видел, как калибровкой пытались исправить выключенный прибор.",["repeat"]="Снова на обходе? Говорите, что проверяете. По одной общей сводке я состояние контура не принимаю.",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Техник смены. Моё дело — принять рабочие цепи, доступы и записи о ремонте. Решения о состоянии испытуемого я за медика не делаю.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="Вычислители, вентиляция и усилители имеют отдельные автоматы. Поэтому экран может гореть, когда усиление уже отключено. Фильтр берут в E-08; там же выполняют ремонт, но это два разных действия.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="В E-04 лежит официальная сводка, в E-07 — первичные временные отметки. Я не стану пересказывать весь журнал вместо него. Сравните, как в этих источниках описан останов.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Да, в моей записи останов ручной: 03:14. Потом восстанавливалась вытяжка. Формулировка «работала непрерывно» этому не равна. Почему первая сводка оказалась такой — из одних этих отметок не видно.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="Восстановленная последовательность полезна тем, что её можно проверить. Она не превращает предположение о причине в факт. Сохраните результат рядом с найденными документами.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="Отсюда удобно начать с операторской E-04. Подписанный журнал — в E-07; расходники и ремонт — E-08. На верхнюю палубу ведёт западная лестница.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}},["MEDIC"]={["first"]="Лидия Кравцова, сопровождение. Я могу говорить о принятой передаче и наблюдении. За техническую причину отказа подпись не ставила.",["repeat"]="Вернулись. Есть новая запись по человеку или пока только результат прибора?",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Принимаю участника после серии и веду медицинскую часть передачи. Исправный прибор и состояние человека — два разных дела.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="Помощь получают в E-06 после остановки. Один комплект не исправит охлаждение и не отменит причину аварийного завершения. Не начинайте новую серию, пока не разобрана техническая часть.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="Акт передачи в E-05 подписан на 03:21. Это можно подтвердить документом. Дальнейшую судьбу отсутствующих людей по оставленным вещам я восстанавливать не стану.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Временная цепочка сходится с приёмом в 03:21. Она не подтверждает фразу, будто наблюдение не потребовалось. Но и не даёт мне права назвать источник всех отклонений.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="Если вы закончили P-03 или P-05, у вас появились проверенные ограничения вывода. Медицинская запись остаётся отдельным источником; не подменяйте её оценкой качества сигнала.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="Посмотрите акт в восстановлении и карту E-06. На тележке оставлены вещи до закрытия передачи; это след маршрута, а не готовый рассказ о человеке.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}},["OPERATOR"]={["first"]="Нина Соколова. Здесь сходятся каналы связи и отображения. Если увидите несовпадение, не исправляйте одно число по другому — сначала сохраните оба.",["repeat"]="С чем пришли на этот раз: с измерением или с тем, что показал экран?",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Я веду нейрооператорскую часть. Знаю устройство отображения и порядок серии. Что находится за границей измерения, я не обещала объяснить.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="Виртуальный канал обрабатывается системой. Независимый измеритель нужен именно потому, что экран не может сам подтвердить собственную точность. В P-05 учитывается ещё и качество эталона.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="Я видела повтор вывода в канале связи. Слово «повтор» здесь относится к отображению. Если написать иначе, из моей заметки получится утверждение, которого я не делала.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Сначала ручной останов, затем восстановление вытяжки. Повтор картинки не меняет эти отметки. Возможных мест ошибки несколько; сейчас нет основания выбрать одно только по впечатлению.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="P-03 даёт порядок записанных событий, P-05 — способ отделить расхождение от ненадёжного эталона. Они помогают удержаться от поспешного вывода, а не найти красивое название причине.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="В комнате связи есть копия журнала. Носовая рубка показывает наружную конструкцию напрямую; не принимайте обработанный экран за второе независимое окно.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}},["ENGINEER"]={["first"]="Марк Белов. Дайте угадаю: одинаковые насосы, значит одна система? Нет. Поэтому здесь всё подписано до муфт и вводов.",["repeat"]="Линии уже сверили? Тогда можно говорить о том, что именно ремонтировали.",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Судовые контуры, ввод питания, вода и насосные узлы. Работаю с соединениями и состояниями. Мне нужна схема и доступ к узлу, а не объяснение на слух.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="Балласт поддерживает судовой объект, бытовая вода обслуживает жилую палубу, THERM отводит тепло лабораторий. Похожие корпуса не соединяют эти задачи автоматически.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="У нас есть следы ремонта и снятые детали. Из этого видно, что меняли. Причина первоначального сбоя требует последовательности показаний; старая муфта сама не даёт её.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Восстановление вытяжки после 03:14 совместимо с технической цепочкой, но это ещё не поиск первой причины. Разделите фактическое переключение и версию о том, зачем его сделали.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="Нормальный результат серии подтверждает условия этой серии. Если после ремонта всё стабильно, это не означает, что задним числом доказана причина старого происшествия.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="Начните с судового распределителя, потом посмотрите бытовой водяной узел и балластную. В E-08 остаётся отдельный лабораторный ремонтный пост.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}},["SECURITY"]={["first"]="Артём Громов, вахта. Проходы не перекрывайте. Содержимое лабораторного отчёта я не подтверждаю своей должностью.",["repeat"]="Вы опять с нижней палубы? Скажите, какую передачу проверяете.",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Слежу за рабочими маршрутами и оформлением передачи. Режим объекта не разрешает смешивать техническое описание с медицинским заключением.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="Основной обход — центральная галерея, западная лестница и существующие нижние переходы. Если оборудование под тревогой, не пытайтесь обойти останов повторным нажатием запуска.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="У программы есть режим содержания: участники — заключённые. Отметка о завершённой серии не отвечает на вопрос о согласии. Это разные записи, даже если в сводке они стоят рядом.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Тогда у вас есть основания проверить формулировки отчёта. У вахты — маршрут передачи. Я не превращу его в показание о причине отказа, которой не видел.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="Принятые протоколы остаются в журнале участника. Это лучше устного «всё в порядке», но область записи всё равно ограничена выполненной процедурой.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="Вахтенный лист здесь. Жилые комнаты и камбуз доступны по галерее; не складывайте контейнеры у лестничных площадок.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}},["ARCHIVIST"]={["first"]="Софья Левина. Прежде чем искать объяснение, найдите исходную запись. Копии и сводки часто выглядят увереннее своих оснований.",["repeat"]="Принесли новый источник? Хорошо. Давайте сначала разберём, что он действительно подтверждает.",["options"]={{["id"]="job",["label"]="За что вы здесь отвечаете?"},{["id"]="work",["label"]="Как связаны эти системы?"},{["id"]="world",["label"]="Что сейчас происходит на объекте?"},{["id"]="incident",["label"]="Что известно об инциденте?"},{["id"]="local",["label"]="Что стоит осмотреть рядом?"},{["id"]="evidence",["label"]="Я нашёл независимый журнал. Что это меняет?",["requires"]={["document"]="DOC_P03_CORRECTION"}},{["id"]="after",["label"]="Что показывают завершённые процедуры?",["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},{["id"]="names",["label"]="Project Zero и PROJECT: NULL — одно и то же?"},{["id"]="close",["label"]="Спасибо. Я продолжу обход."}},["nodes"]={["job"]={["text"]="Веду индекс смен и связь между документами. Я не исправляю первичную запись так, чтобы она совпала с поздним резюме.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["work"]={["text"]="В индексе программы больше тысячи симуляций. Это число зарегистрированных запусков. Нельзя автоматически читать его как число безопасных возвращений.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["incident"]={["text"]="Есть официальная сводка E-04, независимая хронология E-07 и передача E-05. Их расхождения сохранены намеренно: сведение в один гладкий текст уничтожило бы часть свидетельств.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["evidence"]={["text"]="Подписанный журнал не совпадает с утверждением о непрерывной вытяжке и автоматическом останове. Теперь вопрос в происхождении формулировок, а не в том, какую строку стереть.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["document"]="DOC_P03_CORRECTION"}},["after"]={["text"]="Сохраните результаты P-03 и P-05 рядом с источниками. Они позволяют отделять установленную последовательность от интерпретации сигнала. Природа Наблюдателя ими не установлена.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}},["requires"]={["any"]={{["completed"]="P03"},{["completed"]="P05"}}}},["local"]={["text"]="Индекс на рабочем столе. Старые и новые поколения регистрации можно сравнить в E-13. В комнате наблюдения лежит поздняя сверка, когда у вас будет контекст.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["world"]={["text"]="Сейчас серия не идёт. Есть время сравнить документы и проверить рабочие места.",["variants"]={{["when"]={["phase"]="failed"},["text"]="Серия остановлена. Сначала посмотрите причину на пульте. Возвращение зелёной лампы не отменяет запись об отказе."},{["when"]={["phase"]="running"},["text"]="Сейчас идёт серия. Не переключайте автоматы и охлаждение без причины. Участник может выполнить безопасный останов."},{["when"]={["phase"]="prepared"},["text"]="Пульт подготовлен. Следующий шаг — запуск с того же поста. Подготовка не означает, что испытание уже идёт."},{["when"]={["phase"]="completed"},["text"]="Последний цикл принят. Результат добавлен в личный журнал участника; его ещё предстоит сопоставить с другими источниками."}},["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}},["names"]={["text"]="В концептуальном описании встречается Project Zero; в действующих файлах — PROJECT: NULL. У меня нет основания решить, были ли это две программы или два названия. Поэтому записи не переименованы.",["options"]={{["id"]="back",["label"]="Вернуться к вопросам."},{["id"]="close",["label"]="Закончить разговор."}}}}}},["canon"]={["era"]="XXII век",["setting"]="Автономный океанический исследовательский комплекс",["simulations"]="Более тысячи зарегистрированных экспериментальных симуляций",["observer"]="Природа не установлена",["naming"]="PROJECT: NULL сохранено; отношение к Project Zero не определено"}}
</ProtectedString></Properties></Item><Item class="Script" referent="RBX00000000000000000000000070000E5F"><Properties><string name="Name">ProjectNullServer_V10</string><ProtectedString name="Source">-- PROJECT: NULL V11: existing authoritative procedures with ship, staff and dialogue.
-- Legacy architecture/controllers remain responsible for their original equipment.
local RunService = game:GetService("RunService")
if not RunService:IsServer() then return end
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local facility = workspace:WaitForChild("PROJECT_NULL_ARCH_P01", 30)
local network = ReplicatedStorage:WaitForChild("ProjectNullV10", 30)
if not facility or not network then
    warn("PROJECT: NULL V10: facility/network is missing")
    return
end
local Request = network:WaitForChild("Request", 10)
local Push = network:WaitForChild("Push", 10)
if not Request or not Push then
    warn("PROJECT: NULL V10: remotes are missing")
    return
end
local Engine = require(script.Parent:WaitForChild("ExperimentCore"))
local Content = require(script.Parent:WaitForChild("Content"))
local Dialogue = require(script.Parent:WaitForChild("Dialogue"))
local NPCDirector = require(script.Parent:WaitForChild("NPCDirector"))
Dialogue.configure(Content)
local director = NPCDirector.new(facility)
local environment
local environmentOK, environmentProblem = pcall(function()
    local Environment = require(script.Parent:WaitForChild("OceanEnvironment"))
    environment = Environment.setup(require(script.Parent:WaitForChild("ShipConfig")))
end)
if not environmentOK then warn("PROJECT: NULL: exterior environment setup failed: " .. tostring(environmentProblem)) end
local state = Engine.new()
local profiles, contexts, buckets, bound = {}, {}, {}, {}
local documentById, staff = {}, Content.staff or {}
local phaseLabels = {idle = "ОЖИДАНИЕ", prepared = "ПОДГОТОВКА", running = "ИСПЫТАНИЕ", completed = "ЗАВЕРШЕНО", failed = "ОСТАНОВЛЕНО"}
local validExperiments = {P01 = true, P02 = true, P03 = true, P04 = true, P05 = true}
local RECORD_LIMIT, AUTOSAVE_TIME, SAVE_COOLDOWN = 20, 60, 10
local lastSupply = -math.huge
local effects = {beacons = {}, labels = {}, p01Lights = {}, p02Labels = {}, p05Labels = {}, shutters = {}}
local heartbeatElapsed, effectsElapsed, saveElapsed, recordSequence = 0, 0, 0, 0
local closing = false
local idleAwayAt
local movement = {owner = 0, position = nil, time = 0, movingUntil = 0}
local circuitsFolder = facility:WaitForChild("Controls", 10)
circuitsFolder = circuitsFolder and circuitsFolder:WaitForChild("Circuits", 10)

for _, document in ipairs(Content.documents or {}) do
    if type(document.id) == "string" then documentById[document.id] = document end
end

local function now()
    return workspace:GetServerTimeNow()
end

local function copyMap(source)
    local result = {}
    for key, value in pairs(source or {}) do result[key] = value end
    return result
end

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function clipped(value, maximum)
    if type(value) ~= "string" then return "" end
    return string.sub(value, 1, maximum)
end

local function emptyProfile()
    return {version = 11, documents = {}, completed = {}, attempts = {}, records = {}, metStaff = {}}
end

local function cleanRecord(record)
    if type(record) ~= "table" or type(record.id) ~= "string" or not validExperiments[record.experiment] then return nil end
    local result = {
        id = clipped(record.id, 128), experiment = record.experiment,
        title = clipped(record.title, 200), status = record.status == "completed" and "completed" or "failed",
        result = clipped(record.result, 700), timestamp = finite(record.timestamp) and math.floor(record.timestamp) or 0,
    }
    for _, key in ipairs({"elapsed", "rounds", "temperature", "quality"}) do
        if finite(record[key]) then result[key] = math.max(-1000000, math.min(1000000, record[key])) end
    end
    return result
end

local function sanitizeProfile(raw)
    local result = emptyProfile()
    if type(raw) ~= "table" then return result end
    if type(raw.documents) == "table" then
        for key, value in pairs(raw.documents) do
            if documentById[key] and value == true then result.documents[key] = true end
        end
    end
    if type(raw.completed) == "table" then
        for id in pairs(validExperiments) do if raw.completed[id] == true then result.completed[id] = true end end
    end
    if type(raw.metStaff) == "table" then
        for id in pairs(staff) do if raw.metStaff[id] == true then result.metStaff[id] = true end end
    end
    if type(raw.attempts) == "table" then
        for id in pairs(validExperiments) do
            local count = raw.attempts[id]
            if finite(count) then result.attempts[id] = math.max(0, math.min(1000000, math.floor(count))) end
        end
    end
    local seen = {}
    if type(raw.records) == "table" then
        for _, record in ipairs(raw.records) do
            local clean = cleanRecord(record)
            if clean and not seen[clean.id] then
                seen[clean.id] = true
                table.insert(result.records, clean)
            end
            if #result.records &gt;= RECORD_LIMIT then break end
        end
    end
    return result
end

local function mergedRecords(first, second)
    local result, seen = {}, {}
    -- Session records come first; records use stable IDs across retried saves.
    for _, list in ipairs({first, second}) do
        for _, record in ipairs(list or {}) do
            local clean = cleanRecord(record)
            if clean and not seen[clean.id] then
                seen[clean.id] = true
                table.insert(result, clean)
            end
        end
    end
    table.sort(result, function(a, b)
        if a.timestamp == b.timestamp then return a.id &gt; b.id end
        return a.timestamp &gt; b.timestamp
    end)
    while #result &gt; RECORD_LIMIT do table.remove(result) end
    return result
end

local store
local canUseStore = game.GameId ~= nil and game.GameId &gt; 0
if canUseStore then
    local ok, value = pcall(function() return DataStoreService:GetDataStore("PROJECT_NULL_PROGRESS_V10") end)
    if ok then store = value else warn("V10 save service unavailable: " .. tostring(value)) end
end

local function tell(player, message)
    if player and player.Parent == Players then Push:FireClient(player, "notice", message) end
end

local function alive(player)
    if not player or not player:IsA("Player") or player.Parent ~= Players then return nil end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local origin = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
    if not humanoid or humanoid.Health &lt;= 0 or not origin or not origin:IsA("BasePart") then return nil end
    return humanoid, origin, character
end

local function accessible(player, part, prompt)
    local humanoid, origin, character = alive(player)
    if not humanoid or not part or not part:IsA("BasePart") or not part:IsDescendantOf(facility) then return false end
    if not prompt or prompt.Parent ~= part or not prompt.Enabled then return false end
    local distance = part.Position - origin.Position
    if distance.Magnitude &gt; math.max(0, prompt.MaxActivationDistance) + 1 or distance.Magnitude &lt; 0.0001 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = workspace:Raycast(origin.Position, distance, params)
    return hit ~= nil and hit.Instance == part
end

local function takeToken(player, cost)
    local time = now()
    local bucket = buckets[player]
    if not bucket then bucket = {tokens = 8, time = time, hello = -math.huge}; buckets[player] = bucket end
    bucket.tokens = math.min(8, bucket.tokens + math.max(0, time - bucket.time) * 4)
    bucket.time = time
    if bucket.tokens &lt; cost then return false end
    bucket.tokens = bucket.tokens - cost
    return true
end

local function updateMovement()
    local time = now()
    local snapshot = Engine.snapshot(state, time)
    local ownerId = snapshot.owner or 0
    local owner = ownerId ~= 0 and Players:GetPlayerByUserId(ownerId) or nil
    local character = owner and owner.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if movement.owner ~= ownerId or not root or not root:IsA("BasePart") then
        movement.owner, movement.position, movement.time, movement.movingUntil = ownerId, root and root.Position or nil, time, 0
        return
    end
    local elapsed = time - movement.time
    if elapsed &lt; 1 / 120 then return end
    if movement.position then
        local displacement = root.Position - movement.position
        local horizontal = math.sqrt(displacement.X * displacement.X + displacement.Z * displacement.Z)
        -- Server-observed position changes, not a client-supplied "I moved" flag.
        if horizontal &gt; math.max(0.008, elapsed * 0.75) then movement.movingUntil = time + 0.35 end
    end
    movement.position, movement.time = root.Position, time
end

local function inputs()
    local values = {}
    for _, name in ipairs({"Computers", "Ventilation", "AcousticAmplifiers", "PhysicalHall"}) do
        local circuit = circuitsFolder and circuitsFolder:FindFirstChild(name)
        values[name] = circuit ~= nil and circuit:IsA("BoolValue") and circuit.Value == true
    end
    local snapshot = Engine.snapshot(state, now())
    local owner = snapshot.owner and snapshot.owner ~= 0 and Players:GetPlayerByUserId(snapshot.owner) or nil
    values.ownerPresent = snapshot.owner == nil or snapshot.owner == 0 or alive(owner) ~= nil
    values.ownerMoving = movement.movingUntil &gt; now()
    return values
end

local function publicProfile(profile)
    local journal = {}
    for id in pairs(profile.documents) do
        local document = documentById[id]
        if document then
            table.insert(journal, {id = id, title = document.title, room = document.room, body = document.body})
            local entry = journal[#journal]
            entry.author, entry.period = document.author, document.period
            entry.claims, entry.hypotheses = document.claims, document.hypotheses
        end
    end
    table.sort(journal, function(a, b) return a.id &lt; b.id end)
    return {
        documents = copyMap(profile.documents), journal = journal,
        completed = copyMap(profile.completed), attempts = copyMap(profile.attempts),
        metStaff = copyMap(profile.metStaff),
        records = mergedRecords(profile.records, {}), saveStatus = profile.saveStatus,
    }
end

local function sendSnapshot(player)
    local profile = profiles[player]
    if not profile or player.Parent ~= Players then return end
    local snapshot = Engine.snapshot(state, now())
    snapshot.profile = publicProfile(profile)
    snapshot.circuits = inputs()
    snapshot.circuits.ownerPresent = nil
    snapshot.circuits.ownerMoving = nil
    snapshot.evidenceRequired = {}
    if snapshot.experiment == "P03" then
        for _, id in ipairs({"DOC_P03_LOG", "DOC_P03_CORRECTION"}) do
            if not profile.documents[id] then
                local document = documentById[id]
                table.insert(snapshot.evidenceRequired, {id = id, title = document and document.title or id, room = document and document.room or "E-07"})
            end
        end
    end
    snapshot.evidenceReady = #snapshot.evidenceRequired == 0
    local context = contexts[player]
    if context and context.opened then
        snapshot.context = {kind = context.action, argument = context.argument, title = context.title, node = context.dialogueNode}
    end
    Push:FireClient(player, "snapshot", snapshot)
end

local function broadcast()
    for _, player in ipairs(Players:GetPlayers()) do sendSnapshot(player) end
end

local saveProfile
local function loadProfile(player, profile)
    if profile.loading or profile.loaded or not store or player.UserId &lt;= 0 then return end
    profile.loading = true
    profile.saveStatus = "Загрузка сохранения…"
    task.spawn(function()
        local ok, saved = pcall(function() return store:GetAsync("u_" .. tostring(player.UserId)) end)
        profile.loading = false
        if ok then
            local clean = sanitizeProfile(saved)
            for id in pairs(clean.documents) do profile.documents[id] = true end
            for id in pairs(clean.completed) do profile.completed[id] = true end
            for id in pairs(clean.metStaff) do profile.metStaff[id] = true end
            for id in pairs(validExperiments) do
                profile.attempts[id] = (clean.attempts[id] or 0) + (profile.pendingAttempts[id] or 0)
            end
            profile.records = mergedRecords(profile.records, clean.records)
            profile.loaded = true
            profile.saveStatus = profile.dirty and "Есть несохранённые изменения" or "Сохранение загружено"
        else
            -- Never overwrite an unknown persisted profile after a failed read.
            profile.loaded = false
            profile.saveStatus = "Сохранение недоступно; прогресс этой сессии в памяти"
            warn("V10 profile load failed for user " .. tostring(player.UserId) .. ": " .. tostring(saved))
        end
        sendSnapshot(player)
        if player.Parent ~= Players or closing then
            -- A player can leave while GetAsync yields. Preserve any changes
            -- made before the read finished and save only after a successful read.
            if ok and profile.dirty then saveProfile(player, true)
            elseif not profile.saving then profiles[player] = nil end
        end
    end)
end

saveProfile = function(player, force)
    local profile = profiles[player]
    if not profile or profile.saving then return false end
    if not store or player.UserId &lt;= 0 then
        profile.saveStatus = "Локальный режим: прогресс хранится до выхода"
        return false
    end
    if not profile.loaded then
        profile.saveStatus = "Запись отложена: сначала требуется загрузить сохранение"
        if not profile.loading then loadProfile(player, profile) end
        return false
    end
    if not profile.dirty then return true end
    if not force and now() - profile.lastSave &lt; SAVE_COOLDOWN then
        profile.saveStatus = "Сохранение уже запланировано"
        return false
    end
    profile.saving = true
    profile.lastSave = now()
    profile.saveStatus = "Сохранение…"
    local payload = sanitizeProfile(profile)
    local attemptDelta = copyMap(profile.pendingAttempts)
    local revision = profile.revision
    task.spawn(function()
        local ok, saved = pcall(function()
            return store:UpdateAsync("u_" .. tostring(player.UserId), function(previous)
                local merged = sanitizeProfile(previous)
                for id in pairs(payload.documents) do merged.documents[id] = true end
                for id in pairs(payload.completed) do merged.completed[id] = true end
                for id in pairs(payload.metStaff) do merged.metStaff[id] = true end
                for id in pairs(validExperiments) do
                    merged.attempts[id] = math.min(1000000, (merged.attempts[id] or 0) + (attemptDelta[id] or 0))
                end
                merged.records = mergedRecords(payload.records, merged.records)
                return merged
            end)
        end)
        profile.saving = false
        if ok then
            local clean = sanitizeProfile(saved)
            for id in pairs(validExperiments) do
                profile.pendingAttempts[id] = math.max(0, (profile.pendingAttempts[id] or 0) - (attemptDelta[id] or 0))
                profile.attempts[id] = (clean.attempts[id] or 0) + profile.pendingAttempts[id]
            end
            for id in pairs(clean.documents) do profile.documents[id] = true end
            for id in pairs(clean.completed) do profile.completed[id] = true end
            for id in pairs(clean.metStaff) do profile.metStaff[id] = true end
            profile.records = mergedRecords(profile.records, clean.records)
            profile.dirty = profile.revision ~= revision
            profile.saveStatus = profile.dirty and "Есть новые изменения; запись запланирована" or "Прогресс сохранён"
        else
            profile.saveStatus = "Ошибка записи; прогресс остаётся в памяти"
            warn("V10 profile save failed for user " .. tostring(player.UserId) .. ": " .. tostring(saved))
        end
        sendSnapshot(player)
        if player.Parent ~= Players and not profile.saving then profiles[player] = nil end
    end)
    return true
end

local function dirty(profile)
    profile.dirty = true
    profile.revision = profile.revision + 1
    if profile.loaded then profile.saveStatus = "Есть несохранённые изменения" end
end

local function handleEvent(event)
    if type(event) ~= "table" then return end
    local player = finite(event.owner) and Players:GetPlayerByUserId(event.owner) or nil
    if not player and finite(event.owner) then
        for candidate in pairs(profiles) do if candidate.UserId == event.owner then player = candidate; break end end
    end
    local profile = player and profiles[player]
    if event.kind == "damage" then
        local humanoid = alive(player)
        if humanoid and finite(event.amount) then humanoid:TakeDamage(math.max(0, math.min(15, event.amount))) end
    elseif event.kind == "medical" then
        local humanoid = alive(player)
        if humanoid and finite(event.amount) then humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + math.max(0, math.min(25, event.amount))) end
    elseif event.kind == "completed" or event.kind == "failed" then
        if not profile or not validExperiments[event.experiment] then return end
        if event.kind == "completed" then profile.completed[event.experiment] = true end
        local source = type(event.record) == "table" and event.record or {}
        recordSequence = recordSequence + 1
        local record = {}
        for key, value in pairs(source) do record[key] = value end
        record.id = tostring(game.JobId or "local") .. ":" .. tostring(os.time()) .. ":" .. tostring(recordSequence) .. ":" .. tostring(player.UserId)
        record.experiment = event.experiment
        record.status = event.kind
        record.result = type(event.result) == "string" and event.result or source.result or "Протокол завершён"
        record.timestamp = os.time()
        local clean = cleanRecord(record)
        if clean then profile.records = mergedRecords({clean}, profile.records) end
        dirty(profile)
        tell(player, event.kind == "completed" and "Протокол принят. Результат добавлен в журнал." or "Испытание остановлено. Причина записана в журнал.")
    end
end

local refreshEffects
local function dispatch(player, action, argument)
    updateMovement()
    Engine.setInputs(state, inputs())
    local ok, reason, event = Engine.dispatch(state, action, argument, now(), player.UserId)
    if event then handleEvent(event) end
    if ok and action == "start" then
        local profile = profiles[player]
        local id = Engine.snapshot(state, now()).experiment
        if profile and validExperiments[id] then
            profile.attempts[id] = (profile.attempts[id] or 0) + 1
            profile.pendingAttempts[id] = (profile.pendingAttempts[id] or 0) + 1
            dirty(profile)
        end
    end
    if not ok then tell(player, type(reason) == "string" and reason or "Действие сейчас недоступно") end
    if refreshEffects then refreshEffects(Engine.snapshot(state, now())) end
    return ok
end

local function contextAllowed(player, required)
    local context = contexts[player]
    if not context or context.action ~= required or not accessible(player, context.part, context.prompt) then
        tell(player, "Подойдите к соответствующему посту и используйте E.")
        return nil
    end
    return context
end

local function npcTalk(id, player, active)
    if not director then return end
    local ok, problem = pcall(function() director:talk(id, player, active) end)
    if not ok then warn("PROJECT: NULL: NPC conversation state failed: " .. tostring(problem)) end
end

local function closeConversation(player, clear)
    local context = contexts[player]
    if context and context.action == "npc" then
        npcTalk(context.argument, player, false)
        context.dialogueNode, context.dialoguePayload = nil, nil
        context.opened = false
        if clear then contexts[player] = nil end
    end
end

local function dialogue(player, id)
    local context, profile = contexts[player], profiles[player]
    if not context or context.action ~= "npc" or context.argument ~= id or not profile then return false end
    local snapshot = Engine.snapshot(state, now())
    local payload, reason = Dialogue.open(id, profile, snapshot, profile.metStaff)
    if not payload then tell(player, reason or "Разговор сейчас недоступен"); return false end
    context.dialogueNode, context.dialoguePayload, context.dialogueAt = payload.node, payload, now()
    context.dialoguePhase = snapshot.phase
    context.greetingText = payload.text
    if not profile.metStaff[id] then profile.metStaff[id] = true; dirty(profile) end
    npcTalk(id, player, true)
    Push:FireClient(player, "dialogue", payload)
    return true
end

local function chooseDialogue(player, choice)
    if type(choice) ~= "string" or #choice &gt; 40 then return end
    local context = contextAllowed(player, "npc")
    if not context or not context.opened or not context.dialogueNode or context.dialogueBusy then return end
    if now() - (context.dialogueAt or -math.huge) &lt; 0.25 then return end
    context.dialogueBusy, context.dialogueAt = true, now()
    local ok, payload, reason = pcall(function()
        return Dialogue.choose(context.argument, context.dialogueNode, choice,
            profiles[player], Engine.snapshot(state, now()), profiles[player].metStaff)
    end)
    context.dialogueBusy = false
    if not ok then
        closeConversation(player, true)
        tell(player, "Разговор прерван; можно обратиться снова.")
        warn("PROJECT: NULL: dialogue evaluation failed: " .. tostring(payload))
        return
    end
    if not payload then tell(player, reason or "Эта тема сейчас недоступна"); return end
    if payload.node == "start" and context.greetingText then payload.text = context.greetingText end
    context.dialogueNode, context.dialoguePayload = payload.node, payload
    Push:FireClient(player, "dialogue", payload)
    if payload.closed then closeConversation(player, true) end
    sendSnapshot(player)
end

local function openInteraction(player, part, prompt, action, argument)
    if not profiles[player] or not takeToken(player, 1) or not accessible(player, part, prompt) then return end
    if action == "response" then
        local snapshot = Engine.snapshot(state, now())
        if snapshot.owner ~= player.UserId or snapshot.experiment ~= "P02" or snapshot.phase ~= "running" then
            tell(player, "Этот датчик принимает ответ участника активного P-02.")
            return
        end
        if argument ~= "left" and argument ~= "center" and argument ~= "right" then return end
        dispatch(player, "respond", argument)
        broadcast()
        return
    end
    local titles = {console = "Терминал " .. argument, cooling = "Охлаждение", repair = "Ремонтный пост", supply = "Чистые расходники", medical = "Медицинский пост", records = "Архив протоколов", document = "Документ", npc = "Персонал"}
    if not titles[action] then return end
    if action == "document" then
        local document = documentById[argument]
        if not document then return end
        if not Dialogue.canRead(document, profiles[player], Engine.snapshot(state, now())) then
            tell(player, "Эта запись требует контекста. Сначала сверьте независимую хронологию E-07 и индекс C08 либо завершите P-03.")
            return
        end
    elseif action == "npc" and not staff[argument] then return end
    local previous = contexts[player]
    if previous and previous.action == "npc" and previous.argument == argument and action == "npc"
        and previous.opened and previous.dialoguePayload then
        -- A second prompt refreshes the active node, rather than restarting it.
        local refreshed = Dialogue.refresh(argument, previous.dialogueNode,
            profiles[player], Engine.snapshot(state, now()), profiles[player].metStaff)
        if refreshed then
            if refreshed.node == "start" and previous.greetingText then refreshed.text = previous.greetingText end
            previous.dialoguePayload = refreshed
            Push:FireClient(player, "dialogue", refreshed)
            sendSnapshot(player)
            return
        end
    end
    closeConversation(player, true)
    contexts[player] = {part = part, prompt = prompt, action = action, argument = argument, title = titles[action], opened = true}
    if action == "console" and validExperiments[argument] then
        dispatch(player, "select", argument)
    elseif action == "document" then
        local document = documentById[argument]
        if not document then return end
        if not profiles[player].documents[argument] then profiles[player].documents[argument] = true; dirty(profiles[player]) end
        Push:FireClient(player, "document", {id = document.id, title = document.title, room = document.room,
            body = document.body, author = document.author, period = document.period,
            claims = document.claims, hypotheses = document.hypotheses})
    elseif action == "npc" then
        dialogue(player, argument)
    end
    Push:FireClient(player, "context", {kind = action, argument = argument, title = titles[action]})
    sendSnapshot(player)
end

local function bindInteraction(config)
    if bound[config] then return end
    local part = config.Parent
    local actionValue = config:FindFirstChild("Action")
    local argumentValue = config:FindFirstChild("Argument")
    local prompt = part and part:FindFirstChild("V10_Prompt")
    if not part or not part:IsA("BasePart") or not prompt or not prompt:IsA("ProximityPrompt") then return end
    if not actionValue or not actionValue:IsA("StringValue") or not argumentValue or not argumentValue:IsA("StringValue") then return end
    bound[config] = true
    local action, argument = actionValue.Value, argumentValue.Value
    prompt.Triggered:Connect(function(player) openInteraction(player, part, prompt, action, argument) end)
end

local function register(instance)
    if instance.Name == "V10_Interact" and instance:IsA("Folder") then bindInteraction(instance) end
    if instance.Name == "V10_RunBeacon" and instance:IsA("BasePart") then table.insert(effects.beacons, instance) end
    if instance:IsA("TextLabel") and string.sub(instance.Name, 1, 11) == "V10_Status_" then table.insert(effects.labels, instance) end
    if instance:IsA("BasePart") and string.match(instance.Name, "^V10_P01_Light_[ABC]$") then
        table.insert(effects.p01Lights, {part = instance, channel = string.sub(instance.Name, -1)})
    end
    if instance:IsA("TextLabel") and string.match(instance.Name, "^V10_P02_Readout_") then
        local index = ({left = 1, center = 2, right = 3})[string.sub(instance.Name, 17)]
        if index then table.insert(effects.p02Labels, {label = instance, index = index}) end
    end
    if instance:IsA("TextLabel") and instance.Name == "V10_P05_Reference" then table.insert(effects.p05Labels, instance) end
    if instance:IsA("BasePart") and instance.Name == "V10_ObserverShutter" then
        local offset = instance:FindFirstChild("OpenOffset")
        if offset and offset:IsA("Vector3Value") then table.insert(effects.shutters, {part = instance, closed = instance.CFrame, offset = offset.Value}) end
    end
end
for _, instance in ipairs(facility:GetDescendants()) do register(instance) end
facility.DescendantAdded:Connect(function(instance) task.defer(function() register(instance) end) end)

local function playerAdded(player)
    if profiles[player] then return end
    local profile = emptyProfile()
    profile.pendingAttempts, profile.loaded, profile.loading, profile.saving = {}, false, false, false
    profile.revision, profile.lastSave, profile.dirty = 0, -math.huge, false
    profile.lastMedical = -math.huge
    local persistent = store and player.UserId &gt; 0
    profile.saveStatus = persistent and "Загрузка сохранения…" or "Локальный режим: прогресс хранится до выхода"
    profiles[player] = profile
    if persistent then loadProfile(player, profile) end
end
Players.PlayerAdded:Connect(playerAdded)
for _, player in ipairs(Players:GetPlayers()) do playerAdded(player) end

local allowedActions = {hello = true, close = true, dialogue = true, select = true, calibrate = true, start = true, respond = true, abort = true, reset = true, cooling = true, repair = true, medical = true, supply = true, save = true, records = true}
Request.OnServerEvent:Connect(function(player, action, argument)
    if closing or not profiles[player] or type(action) ~= "string" or not allowedActions[action] or not takeToken(player, 1) then return end
    if action == "hello" then
        local bucket = buckets[player]
        if now() - bucket.hello &lt; 1 then return end
        bucket.hello = now()
        sendSnapshot(player)
        return
    elseif action == "close" then
        closeConversation(player, true)
        if contexts[player] then contexts[player].opened = false end
        return
    elseif action == "records" then
        -- A journal contains only the requesting player's discovered information.
        sendSnapshot(player)
        return
    elseif action == "save" then
        saveProfile(player, false)
        sendSnapshot(player)
        return
    end
    if not alive(player) then return end
    if action == "dialogue" then
        chooseDialogue(player, argument)
        return
    elseif action == "abort" then
        local snapshot = Engine.snapshot(state, now())
        if snapshot.owner ~= player.UserId then return end
        dispatch(player, "abort", nil)
    elseif action == "select" or action == "calibrate" or action == "start" or action == "respond" or action == "reset" then
        local context = contextAllowed(player, "console")
        if not context then return end
        local snapshot = Engine.snapshot(state, now())
        if action == "select" then
            if type(argument) ~= "string" or argument ~= context.argument or not validExperiments[argument] then return end
        else
            if snapshot.experiment ~= context.argument then tell(player, "Используйте терминал текущего протокола."); return end
            if action == "respond" and (type(argument) ~= "string" or #argument &gt; 80) then return end
            if action == "respond" and snapshot.experiment == "P02" then
                tell(player, "P-02: подойдите к выбранному датчику в зале и удерживайте E.")
                return
            end
            if action == "calibrate" and snapshot.experiment == "P03" then
                local profile = profiles[player]
                if not profile.documents.DOC_P03_LOG or not profile.documents.DOC_P03_CORRECTION then
                    tell(player, "P-03: сначала найдите официальную сводку в E-04 и подписанный журнал в E-07. Найденные документы останутся в личном журнале.")
                    sendSnapshot(player)
                    return
                end
            end
            if action ~= "respond" then argument = nil end
        end
        dispatch(player, action, argument)
    elseif action == "cooling" then
        if not contextAllowed(player, "cooling") or type(argument) ~= "boolean" then return end
        dispatch(player, "cooling", argument)
    elseif action == "repair" then
        if not contextAllowed(player, "repair") then return end
        dispatch(player, "repair", nil)
    elseif action == "medical" then
        if not contextAllowed(player, "medical") then return end
        local profile = profiles[player]
        if now() - profile.lastMedical &lt; 20 then tell(player, "Повторная помощь доступна через 20 секунд."); return end
        if dispatch(player, "medical", nil) then profile.lastMedical = now() end
    elseif action == "supply" then
        if not contextAllowed(player, "supply") then return end
        if now() - lastSupply &lt; 45 then tell(player, "Следующая выдача расходников — через " .. tostring(math.ceil(45 - (now() - lastSupply))) .. " с."); return end
        if dispatch(player, "resupply", nil) then lastSupply = now() end
    end
    broadcast()
end)

refreshEffects = function(snapshot)
    local color = snapshot.phase == "failed" and Color3.fromRGB(220, 72, 55)
        or snapshot.phase == "running" and Color3.fromRGB(226, 170, 59) or Color3.fromRGB(57, 188, 193)
    for _, part in ipairs(effects.beacons) do
        if part:IsDescendantOf(facility) then
            part.Color = color
            local light = part:FindFirstChildOfClass("PointLight")
            if light then light.Color = color; light.Enabled = true end
        end
    end
    local telemetry = snapshot.telemetry or {}
    local text = string.format("%s / %s\n%.1f °C  |  НАГРУЗКА %.0f%%\n%s", snapshot.experiment or "P-00", phaseLabels[snapshot.phase] or snapshot.phase or "", telemetry.temperature or 0, telemetry.stress or 0, snapshot.statusText or snapshot.objective or "")
    for _, label in ipairs(effects.labels) do if label:IsDescendantOf(facility) then label.Text = text end end
    local cue = snapshot.cue
    local p01Active = snapshot.phase == "running" and snapshot.experiment == "P01" and cue and cue.ready
    local channelColors = {A = Color3.fromRGB(61, 202, 211), B = Color3.fromRGB(235, 183, 62), C = Color3.fromRGB(213, 108, 171)}
    for _, entry in ipairs(effects.p01Lights) do
        local part = entry.part
        if part:IsDescendantOf(facility) then
            local enabled = p01Active and cue.visual == entry.channel or false
            part.Color = enabled and channelColors[entry.channel] or Color3.fromRGB(37, 53, 63)
            local light = part:FindFirstChildOfClass("PointLight")
            if light then light.Enabled = enabled; light.Brightness = enabled and 1.2 or 0; light.Color = channelColors[entry.channel] end
        end
    end
    local routeActive = snapshot.phase == "running" and snapshot.experiment == "P02" and cue
    local routeLabels = {"ЛЕВЫЙ ДАТЧИК", "ЦЕНТРАЛЬНЫЙ ДАТЧИК", "ПРАВЫЙ ДАТЧИК"}
    for _, entry in ipairs(effects.p02Labels) do
        if entry.label:IsDescendantOf(facility) then
            local index = entry.index
            if routeActive then
                entry.label.Text = string.format("%s\nВЫВЕСКА: %s\nНЕЗАВИСИМЫЙ ЛАЗЕР: %.1f stud\nЗАДАНИЕ: %.1f stud\nУДЕРЖИВАЙТЕ E У ДАТЧИКА", routeLabels[index], cue.signs and cue.signs[index] or "—", cue.measurements and cue.measurements[index] or 0, cue.targetDistance or 0)
            else entry.label.Text = routeLabels[index] .. "\nP-02 / ОЖИДАНИЕ СЕРИИ\nЗАПУСК: E-12" end
        end
    end
    for _, label in ipairs(effects.p05Labels) do
        if label:IsDescendantOf(facility) then
            if snapshot.phase == "running" and snapshot.experiment == "P05" and cue then
                label.Text = string.format("НЕЗАВИСИМЫЙ КАНАЛ\n%.2f\nЭТАЛОН: %s\nДОПУСК ±%.2f", cue.physicalReading or 0, cue.referenceQuality == "stable" and "СТАБИЛЕН" or "НЕСТАБИЛЕН", cue.tolerance or .2)
            else label.Text = "НЕЗАВИСИМЫЙ КАНАЛ\nP-05 / ОЖИДАНИЕ СЕРИИ" end
        end
    end
    for _, shutter in ipairs(effects.shutters) do
        if shutter.part:IsDescendantOf(facility) then
            local open = snapshot.phase == "running" and snapshot.experiment == "P04" and cue and cue.observerMode ~= "occluded"
            shutter.part.CFrame = open and shutter.closed + shutter.offset or shutter.closed
        end
    end
end

local function releaseUnusedReservation(snapshot)
    local inactive = snapshot.phase == "idle" or snapshot.phase == "completed" or snapshot.phase == "failed"
    if not inactive or not snapshot.owner or snapshot.owner == 0 then idleAwayAt = nil; return snapshot end
    local owner = Players:GetPlayerByUserId(snapshot.owner)
    local context = owner and contexts[owner]
    local atConsole = context and context.action == "console" and context.argument == snapshot.experiment
        and accessible(owner, context.part, context.prompt)
    if atConsole then idleAwayAt = nil; return snapshot end
    if not idleAwayAt then idleAwayAt = now(); return snapshot end
    if now() - idleAwayAt &lt; 15 then return snapshot end
    -- Only waiting/terminal phases can be released. A recorded result remains
    -- in its owner's journal; prepared/running phases are never discarded here.
    Engine.dispatch(state, "reset", nil, now(), snapshot.owner)
    idleAwayAt = nil
    tell(owner, "Пульт освобождён после завершения/ожидания. Вернитесь к терминалу, чтобы выбрать протокол снова.")
    return Engine.snapshot(state, now())
end

local function maintainConversations(snapshot)
    for player, context in pairs(contexts) do
        if context.action == "npc" and context.opened then
            if not accessible(player, context.part, context.prompt) then
                local identity = Dialogue.identity(context.argument) or {}
                closeConversation(player, true)
                Push:FireClient(player, "dialogue", {id = identity.id, argument = identity.id,
                    name = identity.name, role = identity.role, node = "closed", text = "",
                    options = {}, closed = true})
            else
                -- Reading may take longer than the Director's finite talk lease.
                -- Renew only while server-side physical access remains valid.
                npcTalk(context.argument, player, true)
                if context.dialoguePhase ~= snapshot.phase then
                    context.dialoguePhase = snapshot.phase
                    local payload = Dialogue.refresh(context.argument, context.dialogueNode,
                        profiles[player], snapshot, profiles[player].metStaff)
                    if payload and payload.node == "start" and context.greetingText then payload.text = context.greetingText end
                    if payload and context.dialoguePayload and payload.text ~= context.dialoguePayload.text then
                        context.dialoguePayload = payload
                        Push:FireClient(player, "dialogue", payload)
                    end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function(dt)
    if closing then return end
    if not finite(dt) or dt &lt; 0 then return end
    local elapsed = math.min(dt, 0.25)
    updateMovement()
    Engine.setInputs(state, inputs())
    local events = Engine.step(state, elapsed, now()) or {}
    for _, event in ipairs(events) do handleEvent(event) end
    if director then
        local ok, problem = pcall(function() director:step(elapsed, Engine.snapshot(state, now())) end)
        if not ok then
            warn("PROJECT: NULL: NPC director stopped after an error: " .. tostring(problem))
            pcall(function() director:destroy() end)
            director = nil
        end
    end
    if #events &gt; 0 then broadcast() end
    heartbeatElapsed = heartbeatElapsed + elapsed
    effectsElapsed = effectsElapsed + elapsed
    saveElapsed = saveElapsed + elapsed
    if effectsElapsed &gt;= 0.1 then
        effectsElapsed = 0
        refreshEffects(Engine.snapshot(state, now()))
    end
    if heartbeatElapsed &gt;= 1 then
        heartbeatElapsed = 0
        local snapshot = releaseUnusedReservation(Engine.snapshot(state, now()))
        maintainConversations(snapshot)
        refreshEffects(snapshot)
        broadcast()
    end
    if saveElapsed &gt;= AUTOSAVE_TIME then
        saveElapsed = 0
        for _, player in ipairs(Players:GetPlayers()) do
            local profile = profiles[player]
            if profile and not profile.loaded and store and player.UserId &gt; 0 then loadProfile(player, profile) else saveProfile(player, false) end
        end
    end
end)

refreshEffects(Engine.snapshot(state, now()))

Players.PlayerRemoving:Connect(function(player)
    closeConversation(player, true)
    local snapshot = Engine.snapshot(state, now())
    if snapshot.owner == player.UserId then
        Engine.setInputs(state, {Computers = false, Ventilation = false, AcousticAmplifiers = false, PhysicalHall = false, ownerPresent = false})
        for _, event in ipairs(Engine.step(state, 0, now()) or {}) do handleEvent(event) end
        -- Release a departed owner after the core has recorded the interruption.
        Engine.dispatch(state, "reset", nil, now(), player.UserId)
    end
    contexts[player], buckets[player] = nil, nil
    local profile = profiles[player]
    if profile then
        if not saveProfile(player, true) and not profile.saving and not profile.loading then profiles[player] = nil end
    end
end)

game:BindToClose(function()
    closing = true
    for player in pairs(contexts) do closeConversation(player, true) end
    if director then director:destroy(); director = nil end
    if environment and environment.destroy then
        pcall(function() environment:destroy() end)
        environment = nil
    end
    for _, player in ipairs(Players:GetPlayers()) do saveProfile(player, true) end
    local deadline = os.clock() + 8
    while os.clock() &lt; deadline do
        local saving = false
        for _, profile in pairs(profiles) do if profile.saving or profile.loading then saving = true; break end end
        if not saving then break end
        task.wait(0.1)
    end
end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000070001DA8"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source">-- Server-only dialogue graph evaluation. No Roblox services or client state.
local Dialogue = {}
local content = {staff = {}, dialogues = {}}

function Dialogue.configure(authored)
    assert(type(authored) == "table", "Dialogue content is missing")
    content = authored
end

local function allowed(rule, profile, snapshot, depth)
    if rule == nil then return true end
    if type(rule) ~= "table" or (depth or 0) &gt; 8 then return false end
    profile, snapshot = profile or {}, snapshot or {}
    depth = (depth or 0) + 1
    if rule.document then
        return type(rule.document) == "string" and type(profile.documents) == "table"
            and profile.documents[rule.document] == true
    elseif rule.completed then
        return type(rule.completed) == "string" and type(profile.completed) == "table"
            and profile.completed[rule.completed] == true
    elseif rule.phase then
        return type(rule.phase) == "string" and snapshot.phase == rule.phase
    elseif rule.any then
        if type(rule.any) ~= "table" or #rule.any == 0 then return false end
        for _, item in ipairs(rule.any) do if allowed(item, profile, snapshot, depth) then return true end end
        return false
    elseif rule.all then
        if type(rule.all) ~= "table" or #rule.all == 0 then return false end
        for _, item in ipairs(rule.all) do if not allowed(item, profile, snapshot, depth) then return false end end
        return true
    end
    return false
end

function Dialogue.allowed(rule, profile, snapshot)
    return allowed(rule, profile, snapshot, 0)
end

function Dialogue.canRead(document, profile, snapshot)
    return type(document) == "table" and allowed(document.requires, profile, snapshot, 0)
end

local function getGraph(id)
    if type(id) ~= "string" or #id &gt; 40 then return nil end
    local person = content.staff and content.staff[id]
    local graph = content.dialogues and content.dialogues[id]
    if type(person) ~= "table" or type(graph) ~= "table" then return nil end
    return graph, person
end

local function render(id, nodeId, profile, snapshot, seen)
    local graph, person = getGraph(id)
    if not graph then return nil, "Сотрудник сейчас недоступен" end
    local node, text
    if nodeId == "start" then
        node = graph
        local met = (type(profile.metStaff) == "table" and profile.metStaff[id])
            or (type(seen) == "table" and seen[id])
        text = met and graph["repeat"] or graph.first
    else
        node = graph.nodes and graph.nodes[nodeId]
        if type(node) ~= "table" or not allowed(node.requires, profile, snapshot, 0) then
            return nil, "Для этой темы пока недостаточно подтверждённых сведений"
        end
        text = node.text
        for _, variant in ipairs(node.variants or {}) do
            if allowed(variant.when, profile, snapshot, 0) then text = variant.text; break end
        end
    end
    if type(text) ~= "string" or text == "" then return nil, "Реплика отсутствует" end
    local choices = {}
    for _, choice in ipairs(node.options or {}) do
        local target = choice.id
        local targetNode = graph.nodes and graph.nodes[target]
        local validTarget = target == "close" or target == "back" or type(targetNode) == "table"
        if type(target) == "string" and #target &lt;= 40 and validTarget
            and type(choice.label) == "string" and allowed(choice.requires, profile, snapshot, 0)
            and (not targetNode or allowed(targetNode.requires, profile, snapshot, 0)) then
            table.insert(choices, {id = target, label = choice.label})
        end
        if #choices &gt;= 10 then break end
    end
    return {
        id = id, argument = id, name = person.name or id, role = person.role or "Персонал",
        node = nodeId, text = text, options = choices,
    }
end

function Dialogue.open(id, profile, snapshot, seen)
    if type(profile) ~= "table" or type(snapshot) ~= "table" then return nil, "Нет контекста разговора" end
    return render(id, "start", profile, snapshot, seen)
end

function Dialogue.refresh(id, node, profile, snapshot, seen)
    if type(node) ~= "string" or #node &gt; 40 or type(profile) ~= "table"
        or type(snapshot) ~= "table" then return nil, "Нет контекста разговора" end
    return render(id, node, profile, snapshot, seen)
end

function Dialogue.choose(id, node, choice, profile, snapshot, seen)
    if type(node) ~= "string" or #node &gt; 40 or type(choice) ~= "string" or #choice &gt; 40 then
        return nil, "Недействительный вариант ответа"
    end
    if type(profile) ~= "table" or type(snapshot) ~= "table" then return nil, "Нет контекста разговора" end
    local current, reason = render(id, node, profile, snapshot, seen)
    if not current then return nil, reason end
    local selected = false
    for _, option in ipairs(current.options) do if option.id == choice then selected = true; break end end
    if not selected then return nil, "Эта тема сейчас недоступна" end
    if choice == "close" then
        return {id = id, argument = id, name = current.name, role = current.role,
                node = "closed", text = "", options = {}, closed = true}
    end
    return render(id, choice == "back" and "start" or choice, profile, snapshot, seen)
end

-- Kept private content is never included wholesale in a public payload.
function Dialogue.identity(id)
    local _, person = getGraph(id)
    return person and {id = id, name = person.name, role = person.role} or nil
end

return Dialogue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000070001DA9"><Properties><string name="Name">NPCDirector</string><ProtectedString name="Source">-- Six local R6 staff rigs, one scheduler and no external animation assets.
-- C0 is deliberately used for replicated procedural poses: Motor6D.Transform
-- alone is not a server-to-client animation replication mechanism.
local Director = {}
Director.__index = Director

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
local JOINTS = {"RootJoint", "Neck", "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip"}
local MAX_PATH_REQUESTS = 2

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function clamp(value, lo, hi)
    return math.max(lo, math.min(hi, value))
end

local function horizontal(a, b)
    local x, z = a.X - b.X, a.Z - b.Z
    return math.sqrt(x*x + z*z)
end

local function child(parent, name, className)
    local value = parent and parent:FindFirstChild(name)
    if value and (not className or value:IsA(className)) then return value end
    return nil
end

local function livePlayer(player)
    if not player or not player:IsA("Player") or player.Parent ~= Players then return nil end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
    if humanoid and humanoid.Health &gt; 0 and head and head:IsA("BasePart") then return head, character end
    return nil
end

local function setNetworkOwner(root)
    pcall(function() root:SetNetworkOwner(nil) end)
end

function Director.new(facility)
    local self = setmetatable({facility=facility, rigs={}, byId={}, elapsed=0, accumulated=0,
                              pathRequests=0, destroyed=false, connections={}}, Director)
    local function register(config)
        if self.destroyed or config.Name ~= "V11_NPC" or not config:IsA("Folder") then return end
        local model = config.Parent
        local idValue = child(config, "Id", "StringValue")
        local homeValue = child(config, "Home", "Vector3Value")
        local workValue = child(config, "WorkTarget", "Vector3Value")
        local modeValue = child(config, "WorkMode", "StringValue")
        local root = child(model, "HumanoidRootPart", "BasePart")
        local humanoid = model and model:FindFirstChildOfClass("Humanoid")
        if not idValue or not homeValue or not workValue or not root or not humanoid or self.byId[idValue.Value] then return end
        local height = child(config, "RootHeight", "NumberValue")
        local state = {id=idValue.Value, model=model, root=root, humanoid=humanoid,
                       home=homeValue.Value, work=workValue.Value, mode=modeValue and modeValue.Value or "inspect",
                       facing=child(root,"StaffFacing","AlignOrientation"),
                       rootHeight=height and height.Value or 3.35, route={}, routeIndex=0,
                       joints={}, originals={}, speakers={}, walking=false, generation=0,
                       nextWalk=12+#self.rigs*2.7, pathPending=false, waypoints=nil, waypointIndex=0,
                       moveDeadline=0, lastMovement=0, lastPosition=root.Position,
                       blockedUntil=0, state="working", removed=false}
        for _, instance in ipairs(model:GetDescendants()) do
            if instance:IsA("Motor6D") then
                state.joints[instance.Name] = instance
                state.originals[instance.Name] = instance.C0
            end
        end
        for _, name in ipairs(JOINTS) do
            if not state.joints[name] then
                warn("V11 NPC lacks R6 joint "..name..": "..state.id)
                return
            end
        end
        local route = child(config, "Route", "Folder")
        if route then
            local points=route:GetChildren()
            table.sort(points,function(a,b) return a.Name&lt;b.Name end)
            for _, point in ipairs(points) do
                if point:IsA("Vector3Value") and horizontal(point.Value,state.home)&lt;=18
                   and math.abs(point.Value.Y-state.home.Y)&lt;=1 then
                    table.insert(state.route,point.Value)
                end
            end
        end
        table.insert(state.route,state.home)
        self.byId[state.id]=state
        table.insert(self.rigs,state)
        setNetworkOwner(root)
        humanoid.WalkSpeed=7
        humanoid.AutoRotate=false
        state.moveConnection=humanoid.MoveToFinished:Connect(function(reached)
            if self.destroyed or state.removed or not state.walking or not state.waypoints then return end
            local waypoint=state.waypoints[state.waypointIndex]
            if reached and waypoint and horizontal(root.Position,waypoint.Position)&lt;2.0 then
                state.waypointIndex=state.waypointIndex+1
                local nextPoint=state.waypoints[state.waypointIndex]
                if nextPoint then
                    humanoid:MoveTo(nextPoint.Position)
                    state.moveDeadline=self.elapsed+6
                else
                    self:_stop(state,"working",false)
                    state.nextWalk=self.elapsed+14
                end
            elseif not reached then
                self:_stop(state,"blocked",true)
            end
        end)
        table.insert(self.connections,state.moveConnection)
    end
    for _, instance in ipairs(facility:GetDescendants()) do register(instance) end
    table.insert(self.connections,facility.DescendantAdded:Connect(function(instance)
        if instance.Name=="V11_NPC" then task.defer(function() register(instance) end) end
    end))
    return self
end

function Director:_stop(state, reason, blocked)
    state.generation=state.generation+1
    state.walking=false
    state.waypoints=nil
    state.state=reason or "working"
    state.humanoid.AutoRotate=false
    -- Stop at the actual current position. Never reset CFrame, teleport home or
    -- let a failed navigation request keep pushing against a closed door.
    if state.root.Parent then state.humanoid:MoveTo(state.root.Position) end
    if state.pathConnection then state.pathConnection:Disconnect();state.pathConnection=nil end
    if blocked then
        state.blockedUntil=self.elapsed+12
        state.nextWalk=self.elapsed+12
    end
end

function Director:_requestPath(state, destination)
    if state.pathPending or state.walking or self.pathRequests&gt;=MAX_PATH_REQUESTS
       or self.elapsed&lt;state.blockedUntil then return end
    state.pathPending=true
    state.generation=state.generation+1
    local generation=state.generation
    self.pathRequests=self.pathRequests+1
    task.spawn(function()
        local path
        local ok,problem=pcall(function()
            path=PathfindingService:CreatePath({AgentRadius=1.1,AgentHeight=5.8,
                                              AgentCanJump=false,WaypointSpacing=3})
            path:ComputeAsync(state.root.Position,destination+Vector3.new(0,state.rootHeight,0))
        end)
        self.pathRequests=math.max(0,self.pathRequests-1)
        state.pathPending=false
        if self.destroyed or state.removed or generation~=state.generation or not state.root.Parent then return end
        if not ok or not path or path.Status~=Enum.PathStatus.Success then
            self:_stop(state,"blocked",true)
            if not ok then warn("V11 NPC path unavailable: "..tostring(problem)) end
            return
        end
        local points=path:GetWaypoints()
        if #points&lt;2 or #points&gt;64 then self:_stop(state,"blocked",true);return end
        for _, point in ipairs(points) do
            if horizontal(point.Position,state.home)&gt;20
               or math.abs(point.Position.Y-(state.home.Y+state.rootHeight))&gt;7 then
                self:_stop(state,"blocked",true)
                return
            end
        end
        state.waypoints=points
        state.waypointIndex=2
        state.walking=true
        state.state="walking"
        state.lastPosition=state.root.Position
        state.lastMovement=self.elapsed
        state.moveDeadline=self.elapsed+6
        state.humanoid.AutoRotate=true
        if state.facing then state.facing.Enabled=false end
        state.pathConnection=path.Blocked:Connect(function(index)
            if index&gt;=state.waypointIndex then self:_stop(state,"blocked",true) end
        end)
        state.humanoid:MoveTo(points[2].Position)
    end)
end

function Director:talk(id, player, active)
    if self.destroyed or type(id)~="string" then return false end
    local state=self.byId[id]
    if not state then return false end
    if active==false then
        if not player then return false end
        state.speakers[player]=nil
        return true
    end
    local head=livePlayer(player)
    if not head or horizontal(head.Position,state.root.Position)&gt;12 then return false end
    state.speakers[player]=self.elapsed+45
    if state.walking or state.pathPending then self:_stop(state,"talking",false) end
    state.nextWalk=self.elapsed+15
    state.state="talking"
    return true
end

function Director:_attention(state)
    local closest,distance=nil,12
    for player,expires in pairs(state.speakers) do
        local head=livePlayer(player)
        if not head or expires&lt;self.elapsed or horizontal(head.Position,state.root.Position)&gt;12 then
            state.speakers[player]=nil
        else
            local d=(head.Position-state.root.Position).Magnitude
            if d&lt;distance then closest,distance=head,d end
        end
    end
    if closest then return closest.Position,true end
    -- A nearby staff member may look toward an approaching visible player, but
    -- this never starts or unlocks dialogue without the server interaction.
    for _,player in ipairs(Players:GetPlayers()) do
        local head,character=livePlayer(player)
        if head then
            local d=(head.Position-state.root.Position).Magnitude
            if d&lt;distance then
                local origin=state.model:FindFirstChild("Head")
                local params=RaycastParams.new()
                params.FilterType=Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances={state.model}
                local hit=origin and workspace:Raycast(origin.Position,head.Position-origin.Position,params)
                if hit and hit.Instance and hit.Instance:IsDescendantOf(character) then
                    closest,distance=head,d
                end
            end
        end
    end
    return closest and closest.Position or state.work,false
end

function Director:_pose(state,dt,snapshot)
    local t=self.elapsed
    local target,talking=self:_attention(state)
    local alarm=snapshot.phase=="failed"
    local walking=state.walking
    local atWorkStation=horizontal(state.root.Position,state.work)&lt;=6
    local breath=math.sin(t*1.65)*.025
    local neckPitch,neckYaw,bodyYaw=0,0,0
    local leftArm,rightArm,leftRoll,rightRoll=0,0,-.025,.025
    local leftHip,rightHip=0,0
    local localDirection=state.root.CFrame:VectorToObjectSpace(target-state.root.Position)
    if state.facing then
        state.facing.Enabled=not walking
        local delta=target-state.root.Position
        if not walking and math.abs(delta.X)+math.abs(delta.Z)&gt;.01 then
            state.facing.CFrame=CFrame.Angles(0,atan2(-delta.X,-delta.Z),0)
        end
    end
    if localDirection.Magnitude&gt;.001 then
        local yaw=atan2(-localDirection.X,-localDirection.Z)
        neckYaw=clamp(yaw,-.75,.75)
        neckPitch=clamp(atan2(localDirection.Y-1.7,math.max(.5,math.sqrt(localDirection.X^2+localDirection.Z^2))),-.28,.28)
        bodyYaw=clamp(yaw,-.32,.32)
    end
    if walking then
        local speed=state.root.AssemblyLinearVelocity.Magnitude
        local stride=math.sin(t*6.5)*clamp(speed/7,0,1)*.55
        leftHip,rightHip=stride,-stride
        leftArm,rightArm=-stride*.7,stride*.7
        neckYaw,neckPitch,bodyYaw=0,0,0
        state.state="walking"
    elseif alarm then
        leftArm,rightArm=.24,.38
        rightRoll=.12+math.sin(t*2)*.035
        state.state="alert"
    elseif talking then
        rightArm=.38+math.sin(t*2.1)*.13
        rightRoll=.16+math.sin(t*1.7)*.08
        leftArm=.06
        state.state="talking"
    elseif not atWorkStation and (state.mode=="terminal" or state.mode=="repair" or state.mode=="inspect") then
        -- Inspection routes move away from their fixed station. Do not keep
        -- typing or repairing empty space while waiting to return there.
        leftArm,rightArm=.04,.04
        state.state="waiting"
    elseif state.mode=="terminal" then
        leftArm=.83+math.sin(t*3.0)*.035
        rightArm=.86+math.sin(t*3.4+.5)*.035
        neckPitch=-.16
        state.state="working"
    elseif state.mode=="repair" then
        leftArm=.67
        rightArm=1.12+math.sin(t*2.4)*.13
        rightRoll=.15
        neckPitch=-.13
        state.state="repairing"
    elseif state.mode=="read" then
        leftArm=.78
        rightArm=.9+math.sin(t*.8)*.06
        neckPitch=-.22
        state.state="reading"
    elseif state.mode=="inspect" then
        rightArm=.62+math.sin(t*.75)*.05
        leftArm=.12
        state.state="inspecting"
    else
        neckYaw=neckYaw+math.sin(t*.32)*.08
        state.state="watching"
    end
    local offsets={
        RootJoint=CFrame.new(0,breath,0)*CFrame.Angles(0,bodyYaw,0),
        Neck=CFrame.Angles(-neckPitch,neckYaw,0),
        ["Left Shoulder"]=CFrame.Angles(leftArm,0,leftRoll),
        ["Right Shoulder"]=CFrame.Angles(rightArm,0,rightRoll),
        ["Left Hip"]=CFrame.Angles(leftHip,0,0),
        ["Right Hip"]=CFrame.Angles(rightHip,0,0),
    }
    local alpha=clamp(dt*7.5,0,1)
    for _,name in ipairs(JOINTS) do
        local motor=state.joints[name]
        if motor.Parent then motor.C0=motor.C0:Lerp(state.originals[name]*offsets[name],alpha) end
    end
end

function Director:step(dt,snapshot)
    if self.destroyed or not finite(dt) or dt&lt;0 then return end
    dt=clamp(dt,0,.25)
    self.elapsed=self.elapsed+dt
    self.accumulated=self.accumulated+dt
    if self.accumulated&lt;.1 then return end
    local elapsed=self.accumulated
    self.accumulated=0
    snapshot=type(snapshot)=="table" and snapshot or {}
    for _,state in ipairs(self.rigs) do
        if not state.model:IsDescendantOf(self.facility) or not state.root.Parent or state.humanoid.Health&lt;=0 then
            if not state.removed then
                state.removed=true
                self:_stop(state,"removed",false)
                if state.moveConnection then state.moveConnection:Disconnect() end
            end
        else
            local alert=snapshot.phase=="failed"
            local talking=false
            for player,expires in pairs(state.speakers) do
                local head=livePlayer(player)
                if head and expires&gt;=self.elapsed and horizontal(head.Position,state.root.Position)&lt;=12 then talking=true;break end
            end
            if (alert or talking) and (state.walking or state.pathPending) then self:_stop(state,alert and "alert" or "talking",false) end
            if state.walking then
                local moved=horizontal(state.root.Position,state.lastPosition)
                if moved&gt;.15 then state.lastMovement=self.elapsed;state.lastPosition=state.root.Position end
                if self.elapsed&gt;state.moveDeadline or self.elapsed-state.lastMovement&gt;2.8
                   or horizontal(state.root.Position,state.home)&gt;22 then
                    self:_stop(state,"blocked",true)
                end
            elseif not alert and not talking and not state.pathPending and self.elapsed&gt;=state.nextWalk then
                state.routeIndex=state.routeIndex%#state.route+1
                local target=state.route[state.routeIndex]
                if horizontal(target,state.root.Position)&lt;.8 then
                    state.nextWalk=self.elapsed+9
                else
                    state.nextWalk=self.elapsed+12
                    self:_requestPath(state,target)
                end
            end
            self:_pose(state,elapsed,snapshot)
        end
    end
end

function Director:destroy()
    if self.destroyed then return end
    self.destroyed=true
    for _,state in ipairs(self.rigs) do
        state.generation=state.generation+1
        state.speakers={}
        if state.root.Parent then state.humanoid:MoveTo(state.root.Position) end
        if state.facing then state.facing.Enabled=false end
        if state.pathConnection then state.pathConnection:Disconnect();state.pathConnection=nil end
        for _,name in ipairs(JOINTS) do
            local motor=state.joints[name]
            if motor.Parent then motor.C0=state.originals[name] end
        end
    end
    for _,connection in ipairs(self.connections) do connection:Disconnect() end
    self.connections={}
end

return Director
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000070001DAA"><Properties><string name="Name">OceanEnvironment</string><ProtectedString name="Source">-- Native ocean water and restrained exterior lighting, initialized once.
-- No asset IDs, Terrain:Clear, perpetual loops, RemoteEvents or gameplay state.
local Environment = {}
local active

local function finite(n)
    return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end

local function vector(value, positive)
    if type(value) ~= "table" or #value ~= 3 then return nil end
    for _, n in ipairs(value) do
        if not finite(n) or math.abs(n) &gt; 4096 or (positive and (n &lt;= 0 or n &gt; 2048)) then return nil end
    end
    return Vector3.new(value[1], value[2], value[3])
end

function Environment.setup(config)
    if active and not active.destroyed then return active end
    local lighting = game:GetService("Lighting")
    local run = game:GetService("RunService")
    if not run:IsServer() then error("Ocean environment must be initialized on the server") end
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local state = {destroyed = false, filled = 0, failures = 0, waterReady = false,
                   created = {}, previous = {}, connections = {}, poweredLights = 0}
    local water = type(config) == "table" and config.water or nil
    local boxes = type(water) == "table" and water.fill_boxes or nil
    if terrain and type(boxes) == "table" and #boxes &lt;= 160 then
        for _, box in ipairs(boxes) do
            local center = type(box) == "table" and vector(box.center, false) or nil
            local size = type(box) == "table" and vector(box.size, true) or nil
            if center and size then
                local ok, problem = pcall(function()
                    terrain:FillBlock(CFrame.new(center), size, Enum.Material.Water)
                end)
                if ok then state.filled = state.filled + 1 else
                    state.failures = state.failures + 1
                    warn("V11 ocean section unavailable: " .. tostring(problem))
                end
            else
                state.failures = state.failures + 1
                warn("V11 ocean section has invalid geometry")
            end
        end
        terrain.WaterColor = Color3.fromRGB(18, 46, 56)
        terrain.WaterTransparency = 0.34
        terrain.WaterReflectance = 0.22
        terrain.WaterWaveSize = 0.18
        terrain.WaterWaveSpeed = 8
        state.waterReady = state.filled == #boxes and state.failures == 0
    else
        warn("V11 ocean terrain/config is unavailable; interior systems remain active")
    end
    for _, key in ipairs({"ClockTime", "Brightness", "ExposureCompensation", "FogColor", "FogStart", "FogEnd", "OutdoorAmbient"}) do
        state.previous[key] = lighting[key]
    end
    -- Scene framing, not a canon time or depth. Original interior lights remain.
    lighting.ClockTime = 4.8
    lighting.Brightness = 0.8
    lighting.ExposureCompensation = -0.12
    lighting.OutdoorAmbient = Color3.fromRGB(56, 69, 80)
    lighting.FogColor = Color3.fromRGB(38, 61, 73)
    lighting.FogStart = 180
    lighting.FogEnd = 800
    local atmosphere = lighting:FindFirstChild("OceanAtmosphere_V11")
    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "OceanAtmosphere_V11"
        atmosphere.Parent = lighting
        table.insert(state.created, atmosphere)
    end
    atmosphere.Density = 0.24
    atmosphere.Offset = 0.12
    atmosphere.Color = Color3.fromRGB(128, 158, 173)
    atmosphere.Decay = Color3.fromRGB(41, 60, 75)
    atmosphere.Glare = 0.08
    atmosphere.Haze = 1.6
    if terrain then
        local clouds = terrain:FindFirstChild("OceanClouds_V11")
        if not clouds then
            clouds = Instance.new("Clouds")
            clouds.Name = "OceanClouds_V11"
            clouds.Parent = terrain
            table.insert(state.created, clouds)
        end
        clouds.Cover = 0.66
        clouds.Density = 0.48
        clouds.Color = Color3.fromRGB(119, 137, 148)
    end
    -- The old circuit controller already owns screen/material changes. This
    -- visual adapter only binds newly tagged room luminaires to that same Bool.
    local facility = workspace:FindFirstChild("PROJECT_NULL_ARCH_P01")
    local byCircuit = {}
    if facility then
        for _, part in ipairs(facility:GetDescendants()) do
            if part:IsA("BasePart") and part:FindFirstChild("V11_CircuitVisual") then
                local reference = part:FindFirstChild("Circuit")
                local circuit = reference and reference:IsA("ObjectValue") and reference.Value
                if circuit and circuit:IsA("BoolValue") then
                    byCircuit[circuit] = byCircuit[circuit] or {}
                    for _, light in ipairs(part:GetDescendants()) do
                        if light:IsA("PointLight") or light:IsA("SurfaceLight") or light:IsA("SpotLight") then
                            table.insert(byCircuit[circuit], light)
                            state.poweredLights = state.poweredLights + 1
                        end
                    end
                end
            end
        end
    end
    for circuit, lights in pairs(byCircuit) do
        local function refresh()
            if state.destroyed then return end
            for _, light in ipairs(lights) do
                if light.Parent then light.Enabled = circuit.Value == true end
            end
        end
        refresh()
        table.insert(state.connections, circuit.Changed:Connect(refresh))
    end
    function state:destroy()
        if self.destroyed then return end
        self.destroyed = true
        for _, connection in ipairs(self.connections) do connection:Disconnect() end
        for _, object in ipairs(self.created) do pcall(function() object:Destroy() end) end
        for key, value in pairs(self.previous) do pcall(function() lighting[key] = value end) end
        -- Water belongs to this place. Never clear existing terrain on shutdown.
    end
    active = state
    return state
end

return Environment
