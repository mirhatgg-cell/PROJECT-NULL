rties></Item><Item class="Part" referent="RBX00000000000000000000000000001F94"><Properties><string name="Name">BedPowerConduit</string><Vector3 name="size"><X>0.22</X><Y>0.22</Y><Z>34.0</Z></Vector3><CoordinateFrame name="CFrame"><X>70.0</X><Y>-66.0</Y><Z>22.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">4284643204</Color3uint8><token name="Material">256</token></Properties></Item></Item></Item><Item class="StringValue" referent="RBX000000000000000000000000000003EB"><Properties><string name="Name">README</string><string name="Value">v4 / F02: coupled-field system identification. Three cross-coupled compensators, noisy stationary measurements, sample revision/freshness checks and 8-second stability verification. Future-science fiction implemented as a numerical model, not actual neural technology. Start at E10, read wall protocol, measure three probes, tune compensation, remeasure, validate. Studio runtime not verified.
V5 placement audit: north operator workstation moved clear of wall; compact door controllers; shared airlock doorway pairs; bounded hinged covers; continuous 0.2-stud navigation stripes. F02 research protocol retained. Spatial checks do not replace runtime inspection in Studio.
V6: переработка интерьеров. Кресла, медицинские шасси, регулировка спинки, занятость зоны, питание, закрытые подполные трассы. Это сектор B2, не весь комплекс. Проверка Studio обязательна.</string></Properties></Item><Item class="Folder" referent="RBX000000000000000000000000000003EC"><Properties><string name="Name">Controls</string></Properties><Item class="Folder" referent="RBX000000000000000000000000000003ED"><Properties><string name="Name">Circuits</string></Properties><Item class="BoolValue" referent="RBX000000000000000000000000000003EE"><Properties><string name="Name">Computers</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003EF"><Properties><string name="Name">Ventilation</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003F0"><Properties><string name="Name">AcousticAmplifiers</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000003F1"><Properties><string name="Name">Door_01</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000045C"><Properties><string name="Name">Door_02</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000059D"><Properties><string name="Name">Door_05</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000608"><Properties><string name="Name">Door_06</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000673"><Properties><string name="Name">Door_07</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000006DE"><Properties><string name="Name">Door_08</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000749"><Properties><string name="Name">Door_09</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000007B4"><Properties><string name="Name">Door_10</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000081F"><Properties><string name="Name">Door_11</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000088A"><Properties><string name="Name">Door_12</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000008F5"><Properties><string name="Name">Door_13</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000960"><Properties><string name="Name">Door_14</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX000000000000000000000000000009CB"><Properties><string name="Name">Door_15</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX00000000000000000000000000000A36"><Properties><string name="Name">Door_16</string><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBX0000000000000000000000000000175B"><Properties><string name="Name">PhysicalHall</string><bool name="Value">true</bool></Properties></Item></Item><Item class="StringValue" referent="RBX0000000000000000000000000000150D"><Properties><string name="Name">SystemState</string><string name="Value">IDLE</string></Properties></Item></Item></Item><Item class="SpawnLocation" referent="RBX000000000000000000000000000003E2"><Properties><string name="Name">Arrival</string><Vector3 name="size"><X>6</X><Y>0.3</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>-63.85</Y><Z>-86</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0</R10><R11>1.0</R11><R12>-0.0</R12><R20>-0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><float name="Transparency">1</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4281981676</Color3uint8><bool name="CastShadow">false</bool><bool name="Neutral">true</bool><float name="Duration">0</float></Properties></Item><Item class="Camera" referent="RBX000000000000000000000000000003E7"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>0</X><Y>-56</Y><Z>-88</Z><R00>-1.0</R00><R01>0.0</R01><R02>1.2246467991473532e-16</R02><R10>0</R10><R11>1.0</R11><R12>-0.0</R12><R20>-1.2246467991473532e-16</R20><R21>-0.0</R21><R22>-1.0</R22></CoordinateFrame><token name="CameraType">0</token></Properties></Item></Item><Item class="Lighting" referent="RBX000000000000000000000000000003E6"><Properties><string name="Name">Lighting</string><float name="ClockTime">0</float><bool name="GlobalShadows">true</bool><float name="ExposureCompensation">-0.35</float><float name="Brightness">0.3</float><Color3 name="Ambient"><R>0.18</R><G>0.21</G><B>0.24</B></Color3><Color3 name="OutdoorAmbient"><R>0.12</R><G>0.14</G><B>0.17</B></Color3></Properties></Item><Item class="StarterPlayer" referent="RBX000000000000000000000000000003E8"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">18</float><float name="CameraMinZoomDistance">0.5</float></Properties></Item><Item class="ServerScriptService" referent="RBX000000000000000000000000000003E9"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000001511"><Properties><string name="Name">SystemsController_v2</string><ProtectedString name="Source">local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local facility = workspace:WaitForChild("PROJECT_NULL_ARCH_P01")
local doors = facility:WaitForChild("Doors")
local function power(object)
 local c = object:FindFirstChild("Circuit")
 return not c or (c.Value and c.Value.Value == true)
end
local function canClick(player, target)
 local char = player.Character
 local head = char and char:FindFirstChild("Head")
 if not head or (head.Position-target.Position).Magnitude &gt; 12 then return false end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {char}
 local hit = workspace:Raycast(head.Position, target.Position-head.Position, params)
 return not hit or hit.Instance == target
end
local states = {}
for _, dm in ipairs(doors:GetChildren()) do
 local leaf = dm:FindFirstChild("Leaf")
 if leaf then
  local closed = leaf.CFrame
  local delta = leaf.Size.Y &gt; 12 and Vector3.new(leaf.Size.X+.25,0,0) or Vector3.new(0,leaf.Size.Y+.25,0)
  local elements = {}
  local moving = dm:FindFirstChild("MovingPanel")
  if moving then
   for _, p in ipairs(moving:GetChildren()) do
    if p:IsA("BasePart") then elements[p] = closed:ToObjectSpace(p.CFrame) end
   end
  end
  local drive = Instance.new("CFrameValue")
  drive.Value = closed
  drive.Parent = dm
  local rotor=dm:FindFirstChild("MotorRotor")
  local rotorStart=rotor and rotor.CFrame
  drive.Changed:Connect(function(value)
   leaf.CFrame = value
   for p, relative in pairs(elements) do p.CFrame = value * relative end
   if rotor then rotor.CFrame=rotorStart*CFrame.Angles(0,0,(value.Position-closed.Position).Magnitude*3) end
  end)
  states[dm] = {leaf=leaf,closed=closed,opened=closed*CFrame.new(delta),drive=drive,open=false,busy=false,parts=elements}
 end
end
local function obstructed(s)
 local params = OverlapParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {s.leaf.Parent}
 -- Humanoid detection catches players and future NPCs; static walls are ignored.
 for _, p in ipairs(workspace:GetPartBoundsInBox(s.closed, Vector3.new(s.leaf.Size.X+2,s.leaf.Size.Y+1,5),params)) do
  local model = p:FindFirstAncestorOfClass("Model")
  if model and model:FindFirstChildOfClass("Humanoid") then return true end
 end
 return false
end
local function moveDoor(dm, manual)
 local s = states[dm]
 if not s or s.busy or (not manual and not power(dm)) then return end
 -- Mechanical release opens only; cannot lock someone in during a power outage.
 if manual and s.open then return end
 local opening = not s.open
 if not opening and obstructed(s) then return end
 s.busy = true
 s.leaf.CanCollide = false
 local cancelled = false
 local tween = TweenService:Create(s.drive,TweenInfo.new(manual and 2.2 or .85,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{Value=opening and s.opened or s.closed})
 local guard = RunService.Heartbeat:Connect(function()
  if not opening and obstructed(s) then
   cancelled = true
   tween:Cancel()
  end
 end)
 tween:Play()
 tween.Completed:Wait()
 guard:Disconnect()
 if cancelled then
  local retract=TweenService:Create(s.drive,TweenInfo.new(.5),{Value=s.opened})
  retract:Play();retract.Completed:Wait()
  s.open=true
 else s.open=opening end
 s.leaf.CanCollide=true
 s.busy=false
end
local hatchState = {}
local testBusy=false
local function selfTest()
 if testBusy then return end
 testBusy=true
 local circuits=facility.Controls.Circuits
 local state=facility.Controls.SystemState
 local function message(value)
  state.Value=value
  local screen=facility:FindFirstChild("SystemStatus",true)
  local label=screen and screen:FindFirstChildWhichIsA("TextLabel",true)
  if label then label.Text=value end
 end
 local function fault()
  if not circuits.Computers.Value then return "НЕТ ПИТАНИЯ КОМПЬЮТЕРОВ" end
  if not circuits.Ventilation.Value then return "НЕТ ОБДУВА / ЗАПУСК ЗАПРЕЩЁН" end
  if not circuits.AcousticAmplifiers.Value then return "УСИЛИТЕЛИ ОТКЛЮЧЕНЫ" end
 end
 local reason=fault()
 if reason then message("БЛОКИРОВКА\n"..reason);testBusy=false;return end
 message("P-01 / ПРОВЕРКА\nПИТАНИЕ И ОБДУВ: ГОТОВЫ")
 for _, channel in ipairs({"A","B","C","D"}) do
  for _=1,10 do
   reason=fault()
   if reason then message("ПРЕРВАНО\n"..reason);testBusy=false;return end
   message("P-01 / КАНАЛ "..channel.."\nПРОВЕРКА КОНТРОЛЛЕРА")
   task.wait(.1)
  end
 end
 message("P-01 / ПРОВЕРКА ЗАВЕРШЕНА\n4 КАНАЛА • ПИТАНИЕ • ОБДУВ\nАКУСТИЧЕСКИЙ СИГНАЛ НЕ ГЕНЕРИРУЕТСЯ")
 testBusy=false
end
for _, object in ipairs(facility:GetDescendants()) do
 if object:IsA("BasePart") then
  local detector = object:FindFirstChildOfClass("ClickDetector")
  local action = object:FindFirstChild("Action")
  if detector and action then
   detector.MouseClick:Connect(function(player)
    if not canClick(player,object) then return end
    if action.Value=="Door" or action.Value=="ManualDoor" then
     local target=object:FindFirstChild("Target")
     if target and target.Value then moveDoor(target.Value,action.Value=="ManualDoor") end
    elseif action.Value=="Breaker" then
     local c=object:FindFirstChild("Circuit")
     if c and c.Value then c.Value.Value=not c.Value.Value end
    elseif action.Value=="SelfTest" then
     selfTest()
    elseif action.Value=="Hatch" then
     local s=hatchState[object]
     if not s then s={closed=object.CFrame,open=false,busy=false};hatchState[object]=s end
     if s.busy then return end
     s.busy=true;s.open=not s.open
     local shift=object:FindFirstChild("Slide")
     local pivot=object:FindFirstChild("HingePivot")
     local target=s.closed
     if s.open and pivot then
      local angle=math.rad(object.HingeAngle.Value)
      local rotation=object.HingeAxis.Value=="X" and CFrame.Angles(angle,0,0) or CFrame.Angles(0,angle,0)
      target=s.closed*CFrame.new(pivot.Value)*rotation*CFrame.new(-pivot.Value)
     elseif s.open then target=s.closed*CFrame.new(shift.Value) end
     object.CanCollide=false
     local tween=TweenService:Create(object,TweenInfo.new(.5),{CFrame=target})
     tween:Play();tween.Completed:Wait();object.CanCollide=true;s.busy=false
    end
   end)
  end
 end
end
local loads={}
local fans={}
for _, object in ipairs(facility:GetDescendants()) do
 if object:IsA("BasePart") and object:FindFirstChild("Circuit") then
  table.insert(loads,{part=object,color=object.Color,material=object.Material})
 elseif object:IsA("Model") and object.Name=="Fan" then
  local center=object:FindFirstChild("Center")
  if center then
   local parts={}
   for _, p in ipairs(object:GetChildren()) do if p:IsA("BasePart") then parts[p]=CFrame.new(center.Value):ToObjectSpace(p.CFrame) end end
   table.insert(fans,{model=object,center=CFrame.new(center.Value),parts=parts,angle=0})
  end
 end
end
local function refresh()
 for _, load in ipairs(loads) do
  local p=load.part;local on=power(p)
  p.Color=on and load.color or Color3.fromRGB(61,65,69)
  p.Material=on and load.material or Enum.Material.SmoothPlastic
  for _, descendant in ipairs(p:GetDescendants()) do
   if descendant:IsA("TextLabel") then
    local original=descendant:FindFirstChild("PoweredText")
    if original then descendant.Text=on and original.Value or "НЕТ ПИТАНИЯ" end
   end
  end
 end
end
for _, c in ipairs(facility.Controls.Circuits:GetChildren()) do c.Changed:Connect(refresh) end
refresh()
-- One low-rate loop; no independent per-component frame callbacks.
task.spawn(function()
 while facility.Parent do
  local dt=task.wait(.1)
  for _, f in ipairs(fans) do
   if power(f.model) then
    f.angle=(f.angle+dt*5)%(math.pi*2)
    local frame=f.center*CFrame.Angles(0,0,f.angle)
    for p,offset in pairs(f.parts) do p.CFrame=frame*offset end
   end
  end
 end
end)
</ProtectedString></Properties></Item><Item class="Script" referent="RBX00000000000000000000000000001BBD"><Properties><string name="Name">PhysicalHallController</string><ProtectedString name="Source">-- Fictional coupled-field instrument, normalized laboratory units.
-- This is system identification and feedback, not a real neural procedure.
local Players=game:GetService("Players")
local f=workspace:WaitForChild("PROJECT_NULL_ARCH_P01")
local course=f.Equipment.P02_Equipment.PhysicalCourse
local circuit=f.Controls.Circuits.PhysicalHall
local function label(part) return part:FindFirstChildWhichIsA("TextLabel",true) end
local main=label(course.ArenaStatus)
local owner=nil
local tuning={4,4,4}
local target={3,5,2}
local samples={}
local revision=0
local busy=false
local generation=0
local A={{1,.4,-.2},{-.3,1,.5},{.2,-.4,1}}
local rng=Random.new()
local function status(t) main.Text=t end
local function powered()
 return circuit.Value and f.Controls.Circuits.Computers.Value and f.Controls.Circuits.Ventilation.Value
end
local function residual(i)
 local y=0
 for j=1,3 do y=y+A[i][j]*(tuning[j]-target[j]) end
 return y
end
local function refresh()
 for i=1,3 do
  local s=samples[i]
  local text=s and string.format("ДАТЧИК %d\nОТКЛИК: %+.2f\nПОГРЕШНОСТЬ ±0.02\n%s",i,s.value,s.rev==revision and "ТЕКУЩАЯ НАСТРОЙКА" or "УСТАРЕЛО: ПОВТОРИТЬ") or ("ДАТЧИК "..i.."\nНЕТ ИЗМЕРЕНИЯ")
  label(course["Readout_"..i]).Text=text
  label(course["ControlReadout_"..i]).Text=string.format("КОМПЕНСАТОР %s\n%.1f / 8.0",({"A","B","C"})[i],tuning[i])
 end
end
local function reset(text)
 generation=generation+1;owner=nil;busy=false;samples={};revision=0
 status(text);refresh()
end
local function clickOK(player,part)
 local char=player.Character;local head=char and char:FindFirstChild("Head")
 if not head or (head.Position-part.Position).Magnitude&gt;12 then return false end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={char}
 local hit=workspace:Raycast(head.Position,part.Position-head.Position,params)
 return not hit or hit.Instance==part
end
local function bind(part,callback)
 part.Click.MouseClick:Connect(function(p) if clickOK(p,part) then callback(p) end end)
end
bind(course.StartButton,function(p)
 if owner or not powered() then if not powered() then status("ДОПУСК ОТКЛОНЁН\nПРОВЕРЬТЕ P02 / PC / ВЕНТИЛЯЦИЮ") end;return end
 generation=generation+1;owner=p;busy=false;samples={};revision=0;tuning={4,4,4}
 for i=1,3 do target[i]=rng:NextInteger(2,6) end
 if target[1]==4 and target[2]==4 and target[3]==4 then target[1]=3 end
 status("F-02 / ИДЕНТИФИКАЦИЯ ПОЛЯ\nСНИМИТЕ ОТКЛИК В 3 ТОЧКАХ\nПРИБОРЫ ИСПОЛЬЗУЮТ УСЛОВНЫЕ ЕДИНИЦЫ")
 refresh()
end)
bind(course.ResetButton,function(p) if not owner or owner==p then reset("ПРОТОКОЛ ПРЕКРАЩЁН\nМОЖНО НАЧАТЬ НОВУЮ СЕРИЮ") end end)
for i=1,3 do
 for _, sign in ipairs({-1,1}) do
  local button=course[(sign==1 and "Plus_" or "Minus_")..i]
  bind(button,function(p)
   if p~=owner or busy or not powered() then return end
   tuning[i]=math.clamp(math.floor((tuning[i]+sign*.5)*2+.5)/2,0,8)
   revision=revision+1
   status("НАСТРОЙКА ИЗМЕНЕНА\nКАЖДЫЙ КАНАЛ ВЛИЯЕТ НА НЕСКОЛЬКО ДАТЧИКОВ\nПРОВЕДИТЕ ПОВТОРНЫЕ ИЗМЕРЕНИЯ")
   refresh()
  end)
 end
 bind(course["Probe_"..i],function(p)
  if p~=owner or busy or not powered() then return end
  local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local point=course["Pad_"..i].Position
  if (Vector2.new(root.Position.X,root.Position.Z)-Vector2.new(point.X,point.Z)).Magnitude&gt;4 then status("ВСТАНЬТЕ В ОБЛАСТЬ ДАТЧИКА "..i);return end
  busy=true;local token=generation;local start=root.Position;local sum=0
  status("ИЗМЕРЕНИЕ "..i.." / 2 СЕКУНДЫ\nСОХРАНЯЙТЕ НЕПОДВИЖНОСТЬ")
  for k=1,20 do
   task.wait(.1)
   if token~=generation then return end
   if not root.Parent or (root.Position-start).Magnitude&gt;1.2 or not powered() then
    busy=false;status("ИЗМЕРЕНИЕ ОТБРОШЕНО\nДВИЖЕНИЕ ИЛИ ПОТЕРЯ ПИТАНИЯ");return
   end
   sum=sum+residual(i)+rng:NextNumber(-.02,.02)
  end
  samples[i]={value=sum/20,time=os.clock(),rev=revision};busy=false
  status("ИЗМЕРЕНИЕ ЗАПИСАНО\nСРАВНИТЕ ОТКЛИК ДО И ПОСЛЕ НАСТРОЙКИ")
  refresh()
 end)
end
bind(course.ValidateButton,function(p)
 if p~=owner or busy or not powered() then return end
 for i=1,3 do
  local s=samples[i]
  if not s or s.rev~=revision or os.clock()-s.time&gt;90 then status("НЕДОСТАТОЧНО ДАННЫХ\nНУЖНЫ 3 СВЕЖИХ ИЗМЕРЕНИЯ ОДНОЙ НАСТРОЙКИ");return end
  if math.abs(s.value)&gt;.25 then status("ПОЛЕ НЕ СКОМПЕНСИРОВАНО\nДОПУСК КАЖДОГО ДАТЧИКА: ±0.25\nПРОДОЛЖИТЕ НАСТРОЙКУ");return end
 end
 busy=true;local token=generation
 for k=1,40 do
  task.wait(.2)
  if token~=generation then return end
  if not powered() then reset("АВАРИЙНОЕ ЗАВЕРШЕНИЕ\nПРОПАЛО ПИТАНИЕ ИЛИ ОБДУВ");return end
  local maxError=0
  for i=1,3 do maxError=math.max(maxError,math.abs(residual(i)+.04*math.sin(k*.2+i))) end
  if maxError&gt;.3 then busy=false;status("НЕУСТОЙЧИВЫЙ РЕЖИМ\nПОВТОРИТЕ КОМПЕНСАЦИЮ");return end
  status(string.format("ВЕРИФИКАЦИЯ / %.1f СЕК\nОСТАТОЧНЫЙ ДРЕЙФ: %.3f\nПРЕДЕЛ: 0.30",k*.2,maxError))
 end
 status("F-02 / ПРИНЯТО\nПОЛЕ СКОМПЕНСИРОВАНО\n8 СЕКУНД УСТОЙЧИВОСТИ\nПРОТОКОЛ ЗАВЕРШЁН")
 busy=false;owner=nil
end)
for _, c in ipairs({circuit,f.Controls.Circuits.Computers,f.Controls.Circuits.Ventilation}) do
 c.Changed:Connect(function() if owner and not powered() then reset("ПРОТОКОЛ ПРЕРВАН\nОТКАЗ ПИТАНИЯ ИЛИ ВЕНТИЛЯЦИИ") end end)
end
Players.PlayerRemoving:Connect(function(p) if p==owner then reset("УЧАСТНИК ОТКЛЮЧИЛСЯ") end end)
task.spawn(function()
 while course.Parent do
  task.wait(.5)
  if owner then
   local c=owner.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local p=c and c:FindFirstChild("HumanoidRootPart")
   if not p or not h or h.Health&lt;=0 or p.Position.X&lt;125 or p.Position.X&gt;183 or math.abs(p.Position.Z)&gt;37 then reset("УЧАСТНИК ПОКИНУЛ КАМЕРУ\nПРОТОКОЛ ПРЕРВАН") end
  end
 end
end)
reset("F-02 / КОМПЕНСАЦИЯ СВЯЗАННОГО ПОЛЯ\nОЗНАКОМЬТЕСЬ С ПРОТОКОЛОМ У ВХОДА")
</ProtectedString></Properties></Item><Item class="Script" referent="RBX000000000000000000000000000020A4"><Properties><string name="Name">InteriorSystems_V6</string><ProtectedString name="Source">local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local facility = workspace:WaitForChild("PROJECT_NULL_ARCH_P01")
local circuits = facility:WaitForChild("Controls"):WaitForChild("Circuits")
local beds = {}
local function powered()
 return circuits.Computers.Value
end
local function occupant(bed)
 local pivot = bed.Pivot.Value
 for _,player in ipairs(Players:GetPlayers()) do
  local character = player.Character
  local root = character and character:FindFirstChild("HumanoidRootPart")
  local humanoid = character and character:FindFirstChildOfClass("Humanoid")
  if root and humanoid and humanoid.Health &gt; 0 then
   local d = root.Position-pivot
   if math.abs(d.X)&lt;3.5 and math.abs(d.Z+1)&lt;5.5 and d.Y&gt;-2 and d.Y&lt;6 then return player end
  end
 end
 return nil
end
local function allowed(player,button)
 local char=player.Character
 local head=char and char:FindFirstChild("Head")
 if not head or (head.Position-button.Position).Magnitude&gt;9 then return false end
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={char}
 local hit=workspace:Raycast(head.Position,button.Position-head.Position,params)
 return not hit or hit.Instance==button
end
for _,bed in ipairs(facility:GetDescendants()) do
 if bed:IsA("Model") and bed:FindFirstChild("AdjustableBack") then
  local state={model=bed,raised=false,busy=false,notice="",noticeUntil=0}
  table.insert(beds,state)
  local pivot=CFrame.new(bed.Pivot.Value)
  local parts={}
  for _,part in ipairs(bed.AdjustableBack:GetChildren()) do
   if part:IsA("BasePart") then parts[part]=pivot:ToObjectSpace(part.CFrame) end
  end
  local angle=Instance.new("NumberValue")
  angle.Name="BackAngle"
  angle.Parent=bed
  angle.Changed:Connect(function(value)
   for part,offset in pairs(parts) do part.CFrame=pivot*CFrame.Angles(math.rad(-value),0,0)*offset end
  end)
  bed.BedAdjust.Click.MouseClick:Connect(function(player)
   if state.busy or not allowed(player,bed.BedAdjust) then return end
   if not powered() then return end
   if occupant(bed) then
    state.notice="РЕГУЛИРОВКА: ОСВОБОДИТЕ ЛОЖЕ"
    state.noticeUntil=os.clock()+4
    return
   end
   state.busy=true
   local target=state.raised and 0 or 30
   local tween=TweenService:Create(angle,TweenInfo.new(1.2),{Value=target})
   state.tween=tween
   tween:Play()
   local result=tween.Completed:Wait()
   if result==Enum.PlaybackState.Completed then state.raised=target==30 end
   state.tween=nil
   state.busy=false
  end)
 end
end
-- Loss of power stops actuators; partially raised sections remain in place.
circuits.Computers.Changed:Connect(function(value)
 if not value then
  for _,state in ipairs(beds) do
   if state.tween then state.tween:Cancel() end
  end
 end
end)
local journal={}
for _,o in ipairs(facility:GetDescendants()) do
 if o:IsA("TextLabel") and string.find(o.Text,"СИСТЕМНЫЙ ЖУРНАЛ",1,true) then table.insert(journal,o) end
end
while true do
 for _,state in ipairs(beds) do
  local player=occupant(state.model)
  -- Stop before continuing to move if a player enters the adjustment zone.
  if player and state.tween then state.tween:Cancel() end
  local status=not powered() and "НЕТ ПИТАНИЯ" or (player and "ЗОНА ЗАНЯТА" or "ЗОНА СВОБОДНА")
  if powered() and os.clock()&lt;state.noticeUntil then status=state.notice end
  local text=state.model.BedStatus.Display.Text
  text.Text=state.model.Name.."\n"..status.."\nСПИНКА "..math.floor(state.model.BackAngle.Value+.5).."°"
 end
 for _,text in ipairs(journal) do
  local message="СИСТЕМНЫЙ ЖУРНАЛ\nPC "..(powered() and "ON" or "OFF").." / AIR "..(circuits.Ventilation.Value and "ON" or "OFF").."\nF02 "..(circuits.PhysicalHall.Value and "ПИТАНИЕ ЕСТЬ" or "НЕТ ПИТАНИЯ")
  text.Text=powered() and message or "НЕТ ПИТАНИЯ"
  local original=text:FindFirstChild("PoweredText")
  if original then original.Value=message end
 end
 task.wait(.2)
end
</ProtectedString></Properties></Item><Item class="Script" referent="RBX00000000000000000000000070000A61"><Properties><string name="Name">ServiceController_V9</string><ProtectedString name="Source">-- PROJECT: NULL V9 — server-authoritative service access and actual circuit state.
-- Main collision surfaces stay enabled during motion. No RemoteEvents are used.
local run = game:GetService("RunService")
if not run:IsServer() then return end

local facility = workspace:WaitForChild("PROJECT_NULL_ARCH_P01", 30)
if not facility then
    warn("V9 service controller: facility was not found")
    return
end

local STEPS = 30
local STEP_TIME = 0.025
local EPSILON = 0.000001
local AXES = {
    X = Vector3.new(1, 0, 0),
    Y = Vector3.new(0, 1, 0),
    Z = Vector3.new(0, 0, 1),
}
local OCCUPANCY_PADDING = Vector3.new(0.15, 0.15, 0.15)
local seenServices, seenStops, seenStatuses = {}, {}, {}

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function child(parent, name, className)
    local result = parent and parent:FindFirstChild(name)
    if result and result:IsA(className) then return result end
    return nil
end

local function liveHumanoid(part)
    local ancestor = part
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Model") then
            local humanoid = ancestor:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health &gt; 0 then return humanoid end
        end
        ancestor = ancestor.Parent
    end
    return nil
end

local function authorized(player, target, prompt, permitted)
    if not player or not player:IsA("Player") or not target:IsDescendantOf(facility) then return false end
    if not prompt.Enabled then return false end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health &lt;= 0 then return false end
    local origin = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not origin or not origin:IsA("BasePart") then return false end
    local direction = target.Position - origin.Position
    local maxDistance = math.max(0, prompt.MaxActivationDistance) + 1
    if direction.Magnitude &gt; maxDistance or direction.Magnitude &lt; 0.0001 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = workspace:Raycast(origin.Position, direction, params)
    return hit ~= nil and permitted[hit.Instance] == true
end

local function motion(state, progress)
    if state.axis == "Slide" then
        return CFrame.new(state.slide * progress)
    end
    local pivot = state.pivot
    return CFrame.new(pivot) * CFrame.fromAxisAngle(AXES[state.axis], math.rad(state.openAngle * progress))
        * CFrame.new(-pivot.X, -pivot.Y, -pivot.Z)
end

local function nextTarget(state, attemptedTarget)
    if state.progress &lt;= EPSILON then return 1 end
    if state.progress &gt;= 1 - EPSILON then return 0 end
    return 1 - attemptedTarget
end

local function refresh(state)
    state.current.Value = state.progress * state.openAngle
    state.isOpen.Value = state.progress &gt;= 1 - EPSILON
    local action = state.target &gt; state.progress and "Открыть" or "Закрыть"
    if state.progress &gt; EPSILON and state.progress &lt; 1 - EPSILON then
        action = action .. " (пауза)"
    end
    state.prompt.ActionText = action
end

local function candidateFrames(state, progress)
    local transform = motion(state, progress)
    local frames = {}
    for i, mover in ipairs(state.movers) do
        assert(mover.part:IsDescendantOf(facility), "A service mover was removed from the facility")
        frames[i] = transform * mover.closed
    end
    return frames
end

local function occupied(state, frames)
    for i, mover in ipairs(state.movers) do
        local hits = workspace:GetPartBoundsInBox(frames[i], mover.part.Size + OCCUPANCY_PADDING, state.overlap)
        for _, hit in ipairs(hits) do
            if liveHumanoid(hit) then return true end
        end
    end
    return false
end

local function applyFrames(state, frames, progress)
    -- A property failure must not leave half the assembly at the next pose.
    local previous = {}
    for i, mover in ipairs(state.movers) do previous[i] = mover.part.CFrame end
    local ok, problem = pcall(function()
        for i, mover in ipairs(state.movers) do mover.part.CFrame = frames[i] end
    end)
    if not ok then
        for i, mover in ipairs(state.movers) do
            pcall(function() mover.part.CFrame = previous[i] end)
        end
        error(problem, 0)
    end
    state.progress = progress
    state.current.Value = progress * state.openAngle
    state.isOpen.Value = progress &gt;= 1 - EPSILON
end

local function activate(state, player)
    if state.busy or not authorized(player, state.panel, state.prompt, state.permitted) then return end
    state.busy = true
    local enabledBefore = state.prompt.Enabled
    state.prompt.Enabled = false
    local target = state.target
    local start = state.progress
    local ok, problem = xpcall(function()
        for step = 1, STEPS do
            local t = step / STEPS
            local smooth = t * t * (3 - 2 * t)
            local progress = start + (target - start) * smooth
            local frames = candidateFrames(state, progress)
            -- Reject the next occupied pose before assigning any CFrame.
            if occupied(state, frames) then break end
            applyFrames(state, frames, progress)
            task.wait(STEP_TIME)
        end
    end, function(message) return tostring(message) end)
    state.target = nextTarget(state, target)
    state.busy = false
    pcall(function() refresh(state) end)
    pcall(function() state.prompt.Enabled = enabledBefore end)
    if not ok then warn("V9 service motion stopped: " .. problem) end
end

local function bindService(config)
    if seenServices[config] then return end
    local panel = config.Parent
    local prompt = panel and child(panel, "V9_ServicePrompt", "ProximityPrompt")
    if not panel or not panel:IsA("BasePart") or not prompt then return end
    local pivot = child(config, "Pivot", "Vector3Value")
    local axis = child(config, "Axis", "StringValue")
    local angle = child(config, "OpenAngle", "NumberValue")
    local current = child(config, "CurrentAngle", "NumberValue")
    local isOpen = child(config, "IsOpen", "BoolValue")
    if not pivot or not axis or not angle or not current or not isOpen then
        warn("V9 service panel has incomplete metadata: " .. panel:GetFullName())
        return
    end
    if not finite(angle.Value) or math.abs(angle.Value) &lt; EPSILON or not finite(current.Value) then return end
    if axis.Value ~= "Slide" and (not AXES[axis.Value] or math.abs(angle.Value) &gt; 150) then return end
    local slide = child(config, "Slide", "Vector3Value")
    if axis.Value == "Slide" and not slide then return end
    local state = {
        panel = panel, prompt = prompt, pivot = pivot.Value, axis = axis.Value,
        openAngle = angle.Value, current = current, isOpen = isOpen,
        slide = slide and slide.Value or Vector3.new(0, 0, 0),
        movers = {}, permitted = {}, busy = false,
        progress = math.max(0, math.min(1, current.Value / angle.Value)),
    }
    local initialInverse = motion(state, state.progress):Inverse()
    local moverParts = {}
    local function addMover(part)
        if part and part:IsA("BasePart") and part:IsDescendantOf(facility) and not state.permitted[part] then
            state.permitted[part] = true
            table.insert(moverParts, part)
            table.insert(state.movers, {part = part, closed = initialInverse * part.CFrame})
        end
    end
    addMover(panel)
    for _, reference in ipairs(config:GetChildren()) do
        if reference:IsA("ObjectValue") and string.match(reference.Name, "^Moving_%d+$") then
            addMover(reference.Value)
        end
    end
    state.overlap = OverlapParams.new()
    state.overlap.FilterType = Enum.RaycastFilterType.Exclude
    state.overlap.FilterDescendantsInstances = moverParts
    state.target = state.progress &gt; EPSILON and 0 or 1
    refresh(state)
    seenServices[config] = true
    prompt.Triggered:Connect(function(player) activate(state, player) end)
end

local function bindStop(prompt)
    if seenStops[prompt] then return end
    local button = prompt.Parent
    if not button or not button:IsA("BasePart") then return end
    local controls = child(facility, "Controls", "Folder")
    local circuits = controls and child(controls, "Circuits", "Folder")
    local amplifier = circuits and child(circuits, "AcousticAmplifiers", "BoolValue")
    if not amplifier then return end
    seenStops[prompt] = true
    local permitted = {[button] = true}
    prompt.Triggered:Connect(function(player)
        if authorized(player, button, prompt, permitted) then amplifier.Value = false end
    end)
end

local function bindStatus(config)
    if seenStatuses[config] then return end
    local circuitRef = child(config, "Circuit", "ObjectValue")
    local indicatorRef = child(config, "Indicator", "ObjectValue")
    local textRef = child(config, "Text", "ObjectValue")
    local caption = child(config, "Caption", "StringValue")
    local circuit = circuitRef and circuitRef.Value
    local indicator = indicatorRef and indicatorRef.Value
    local text = textRef and textRef.Value
    if not circuit or not circuit:IsA("BoolValue") or not indicator or not indicator:IsA("BasePart")
        or not text or not text:IsA("TextLabel") or not caption then return end
    local function update()
        if not indicator:IsDescendantOf(facility) or not text:IsDescendantOf(facility) then return end
        local on = circuit.Value == true
        indicator.Color = on and Color3.fromRGB(59, 191, 202) or Color3.fromRGB(180, 66, 55)
        text.Text = caption.Value .. "\n" .. (on and "ПИТАНИЕ ВКЛЮЧЕНО" or "ПИТАНИЕ ОТКЛЮЧЕНО")
    end
    seenStatuses[config] = true
    update()
    circuit.Changed:Connect(function() pcall(update) end)
end

local function inspect(instance)
    if instance:IsA("Folder") and instance.Name == "V9_Service" then
        bindService(instance)
    elseif instance:IsA("ProximityPrompt") and instance.Name == "V9_EStopPrompt" then
        bindStop(instance)
    elseif instance:IsA("Folder") and instance.Name == "V9_CircuitStatus" then
        bindStatus(instance)
    end
end

for _, instance in ipairs(facility:GetDescendants()) do inspect(instance) end
facility.DescendantAdded:Connect(function(instance)
    -- Deferred binding also permits complete off-tree assemblies to be inserted.
    task.defer(function() inspect(instance) end)
end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item></roblox>