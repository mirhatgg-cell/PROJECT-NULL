1. Начните серию.
2. Встаньте у каждого зонда и снимите отклик.
3. Изменяйте один компенсатор за раз. Сравнивайте показания: каналы взаимосвязаны.
4. Добейтесь |отклика| ≤ 0.25 во всех точках.
5. Снимите три свежих измерения без изменения настроек и запустите проверку.
Единицы условные. Поле — модель вымышленной установки.</string><Color3 name="TextColor3"><R>0.5</R><G>0.9</G><B>1</B></Color3></Properties></Item></Item></Item><Item class="Part" referent="RBX00000000000000000000000000001CFA"><Properties><string name="Name">HingeKnuckle</string><Vector3 name="size"><X>0.22</X><Y>0.22</Y><Z>0.22</Z></Vector3><CoordinateFrame name="CFrame"><X>173.62</X><Y>-61.128</Y><Z>28.06</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">4285432460</Color3uint8><token name="Material">256</token></Properties></Item><Item class="Part" referent="RBX00000000000000000000000000001CFB"><Properties><string name="Name">HingeKnuckle</string><Vector3 name="size"><X>0.22</X><Y>0.22</Y><Z>0.22</Z></Vector3><CoordinateFrame name="CFrame"><X>173.62</X><Y>-58.872</Y><Z>28.06</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">4285432460</Color3uint8><token name="Material">256</token></Properties></Item></Item><Item class="Model" referent="RBX000000000000000000000000000019EE"><Properties><string name="Name">StoredTestModule</string></Properties><Item class="Part" referent="RBX000000000000000000000000000019EF"><Properties><string name="Name">FramePost</string><Vector3 name="size"><X>0.4</X><Y>6</Y><Z>5</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurfac