  end
 end
end)
reset("F-02 / КОМПЕНСАЦИЯ СВЯЗАННОГО ПОЛЯ\nОЗНАКОМЬТЕСЬ С ПРОТОКОЛОМ У ВХОДА")
</ProtectedString></Properties></Item><Item class="Script" referent="RBX000000000000000000000000000020A4"><Properties><string name="Name">InteriorSystems_V6</string><ProtectedString name="Source">local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local facility = workspace:WaitForChild("PROJECT_NULL_ARCH_P01")
local circuits = facility:WaitForChild("Controls"):WaitForChild("Circuits")
local beds = {}
local function powered()
 return circuits.Computers.Value
end
local function occupant(bed)
 local pivot = bed.Pivot.Value
 for _,player in ipairs(Players:GetPlayers()) do
  local character = player.Character
  local root = character and character:FindFirstChild("HumanoidRootPart")
  local humanoid = character and character:FindFirstChildOfClass("Humanoid")
  if root and humanoid and humanoid.Health &gt; 0 then
   local d = root.Position-pivot
   if math.abs(d.X)&lt;3.5 and math.abs(d.Z+1)&lt;5.5 and d.Y&gt;-2 and d.Y&lt;6 then return player end
  end
 end
 return nil
end
local function allowed(player,button)
 local char=player.Character
 local head=char and char:FindFirstChild("Head")
 if not head or (head.Position-button.Position).Magnitude&gt;9 then return false end
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={char}
 local hit=workspace:Raycast(head.Position,button.Position-head.Position,params)
 return not hit or hit.Instance==button
end
for _,bed in ipairs(facility:GetDescendants()) do
 if bed:IsA("Model") and bed:FindFirstChild("AdjustableBack") then
  local state={model=bed,raised=false,busy=false,notice="",noticeUntil=0}
  table.insert(beds,state)
  local pivot=CFrame.new(bed.Pivot.Value)
  local parts={}
  for _,part in ipairs(bed.AdjustableBack:GetChildren()) do
   if part:IsA("BasePart") then parts[part]=pivot:ToObjectSpace(part.CFrame) end
  end
  local angle=Instance.new("NumberValue")
  angle.Name="BackAngle"
  angle.Parent=bed
  angle.Changed:Connect(function(value)
   for part,offset in pairs(parts) do part.CFrame=pivot*CFrame.Angles(math.rad(-value),0,0)*offset end
  end)
  bed.BedAdjust.Click.MouseClick:Connect(function(player)
   if state.busy or not allowed(player,bed.BedAdjust) then return end
   if not powered() then return end
   if occupant(bed) then
    state.notice="РЕГУЛИРОВКА: ОСВОБОДИТЕ ЛОЖЕ"
    state.noticeUntil=os.clock()+4
    return
   end
   state.busy=true
   local target=state.raised and 0 or 30
   local tween=TweenService:Create(angle,TweenInfo.new(1.2),{Value=target})
   state.tween=tween
   tween:Play()
   local result=tween.Completed:Wait()
   if result==Enum.PlaybackState.Completed then state.raised=target==30 end
   state.tween=nil
   state.busy=false
  end)
 end
end
-- Loss of power stops actuators; partially raised sections remain in place.
circuits.Computers.Changed:Connect(function(value)
 if not value then
  for _,state in ipairs(beds) do
   if state.tween then state.tween:Cancel() end
  end
 end
end)
local journal={}
for _,o in ipairs(facility:GetDescendants()) do
 if o:IsA("TextLabel") and string.find(o.Text,"СИСТЕМНЫЙ ЖУРНАЛ",1,true) then table.insert(journal,o) end
end
while true do
 for _,state in ipairs(beds) do
  local player=occupant(state.model)
  -- Stop before continuing to move if a player enters the adjustment zone.
  if player and state.tween then state.tween:Cancel() end
  local status=not powered() and "НЕТ ПИТАНИЯ" or (player and "ЗОНА ЗАНЯТА" or "ЗОНА СВОБОДНА")
  if powered() and os.clock()&lt;state.noticeUntil then status=state.notice end
  local text=state.model.BedStatus.Display.Text
  text.Text=state.model.Name.."\n"..status.."\nСПИНКА "..math.floor(state.model.BackAngle.Value+.5).."°"
 end
 for _,text in ipairs(journal) do
  local message="СИСТЕМНЫЙ ЖУРНАЛ\nPC "..(powered() and "ON" or "OFF").." / AIR "..(circuits.Ventilation.Value and "ON" or "OFF").."\nF02 "..(circuits.PhysicalHall.Value and "ПИТАНИЕ ЕСТЬ" or "НЕТ ПИТАНИЯ")
  text.Text=powered() and message or "НЕТ ПИТАНИЯ"
  local original=text:FindFirstChild("PoweredText")
  if original then original.Value=message end
 end
 task.wait(.2)
end
